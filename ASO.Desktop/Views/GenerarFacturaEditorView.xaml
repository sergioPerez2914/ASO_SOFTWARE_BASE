<UserControl x:Class="ASO.Desktop.Views.GenerarFacturaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="520">

  <StackPanel>
    <TextBlock Text="Remesas recibidas pendientes de facturar"
               Style="{StaticResource FormLabelStyle}" />

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
            MaxHeight="280">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Remesas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <CheckBox IsChecked="{Binding IsSeleccionada}" Cursor="Hand" VerticalContentAlignment="Center">
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="{Binding Descripcion}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detalle}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Text="{Binding TotalTexto}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"
               Foreground="{StaticResource TextPrimaryBrush}" />

    <TextBlock Text="El estimado usa las tarifas de cobro vigentes hoy; la factura aplica la tarifa vigente a la fecha en que se recibió cada remesa."
               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
               Foreground="{StaticResource TextMutedBrush}" />
  </StackPanel>
</UserControl>
