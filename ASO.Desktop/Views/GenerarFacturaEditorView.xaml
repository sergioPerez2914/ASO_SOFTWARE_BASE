<UserControl x:Class="ASO.Desktop.Views.GenerarFacturaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="520">

  <StackPanel>
    <TextBlock Text="Remesas recibidas pendientes de facturar"
               Style="{StaticResource FormLabelStyle}" />

    <!-- Acotar por fechas y marcar en bloque: lo habitual es facturar la semana entera. -->
    <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
      <TextBlock Text="Del" VerticalAlignment="Center" FontSize="{StaticResource FsCaption}"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <DatePicker Style="{StaticResource FormDatePickerStyle}" Width="130" Margin="8,0,0,0"
                  SelectedDate="{Binding Desde}" />
      <TextBlock Text="al" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="{StaticResource FsCaption}"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <DatePicker Style="{StaticResource FormDatePickerStyle}" Width="130" Margin="8,0,0,0"
                  SelectedDate="{Binding Hasta}" />

      <Button Content="Marcar todas" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"
              Command="{Binding MarcarTodasCommand}" />
      <Button Content="Quitar selección" Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding QuitarSeleccionCommand}" />
    </WrapPanel>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadSm}"
            MaxHeight="280">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Remesas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="8,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                      Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}">
                <CheckBox IsChecked="{Binding IsSeleccionada}" Cursor="Hand" VerticalContentAlignment="Center">
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="{Binding Descripcion}" FontSize="{StaticResource FsBody}" FontWeight="{StaticResource FwMedium}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detalle}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Text="{Binding TotalTexto}" FontSize="{StaticResource FsBody}" FontWeight="{StaticResource FwMedium}" Margin="0,8,0,0"
               Foreground="{DynamicResource TextPrimaryBrush}" />

    <TextBlock Text="El estimado usa las tarifas de cobro vigentes hoy; la factura aplica la tarifa vigente a la fecha en que se recibió cada remesa."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{DynamicResource TextMutedBrush}" />
  </StackPanel>
</UserControl>
