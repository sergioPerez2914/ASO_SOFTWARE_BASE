<UserControl x:Class="ASO.Desktop.Views.RemesaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="700">

  <UserControl.Resources>
    <Style x:Key="SeccionStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
      <Setter Property="Margin" Value="0,16,0,4" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>
  </UserControl.Resources>

  <StackPanel>

    <!-- Ubicación de la cosecha -->
    <TextBlock Text="Ubicación de la cosecha" Style="{StaticResource SeccionStyle}" Margin="0,0,0,4" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0">
        <TextBlock Text="Finca (código y nombre)" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Fincas}" DisplayMemberPath="Etiqueta"
                  SelectedItem="{Binding FincaSeleccionada}" />
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="2">
        <TextBlock Text="Tipo de cosecha" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding TiposCosecha}"
                  SelectedItem="{Binding TipoCosechaSeleccionado}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock Text="Lote" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Lotes}" DisplayMemberPath="Nombre"
                  SelectedItem="{Binding LoteSeleccionado}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2">
        <TextBlock Text="Tablón" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Tablones}" DisplayMemberPath="Nombre"
                  SelectedItem="{Binding TablonSeleccionado}" />
      </StackPanel>
    </Grid>

    <!-- Personal y vehículo -->
    <TextBlock Text="Personal y vehículo" Style="{StaticResource SeccionStyle}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0">
        <TextBlock Text="Operador (conduce la máquina de corte)" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Operadores}" DisplayMemberPath="Nombre"
                  SelectedItem="{Binding OperadorSeleccionado}" />
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="2">
        <TextBlock Text="C.O.D del operador" Style="{StaticResource FormLabelStyle}" />
        <TextBlock Text="{Binding OperadorNucleoCodigo}" Style="{StaticResource FormValorCalculadoStyle}"
                   Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock Text="Tractorista" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Tractoristas}" DisplayMemberPath="Nombre"
                  SelectedItem="{Binding TractoristaSeleccionado}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2">
        <TextBlock Text="C.O.D del tractorista" Style="{StaticResource FormLabelStyle}" />
        <TextBlock Text="{Binding TractoristaNucleoCodigo}" Style="{StaticResource FormValorCalculadoStyle}"
                   Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="0">
        <TextBlock Text="Chofer" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Choferes}" DisplayMemberPath="Nombre"
                  SelectedItem="{Binding ChoferSeleccionado}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="2">
        <TextBlock Text="Placa de la unidad" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Vehiculos}" DisplayMemberPath="Etiqueta"
                  SelectedItem="{Binding VehiculoSeleccionado}" />
      </StackPanel>
    </Grid>

    <StackPanel>
      <TextBlock Text="Remesero (autorizado por el núcleo para llenar la remesa)"
                 Style="{StaticResource FormLabelStyle}" />
      <ComboBox Style="{StaticResource FormComboBoxStyle}" HorizontalAlignment="Left" Width="330"
                ItemsSource="{Binding Remeseros}" DisplayMemberPath="Nombre"
                SelectedItem="{Binding RemeseroSeleccionado}" />
    </StackPanel>

    <!-- Núcleo: no se elige, es el de la instalación -->
    <TextBlock Text="Núcleo (determina el pago)" Style="{StaticResource SeccionStyle}" />
    <StackPanel>
      <TextBlock Text="Corte, alza y empuje, y transporte" Style="{StaticResource FormLabelStyle}" />
      <TextBlock Style="{StaticResource FormValorCalculadoStyle}">
        <Run Text="{Binding NucleoCodigo, Mode=OneWay}" />
        <Run Text=" · " />
        <Run Text="{Binding NucleoNombre, Mode=OneWay}" />
      </TextBlock>
    </StackPanel>

    <!-- Tiempos de carga -->
    <TextBlock Text="Tiempos de carga" Style="{StaticResource SeccionStyle}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Inicio de carga (fecha y hora)" Style="{StaticResource FormLabelStyle}" />
        <StackPanel Orientation="Horizontal">
          <DatePicker Style="{StaticResource FormDatePickerStyle}" Width="150"
                      SelectedDate="{Binding InicioCargaFecha}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}" Width="70" Margin="8,0,0,0"
                   Text="{Binding InicioCargaHora, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Hora en formato HH:mm" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Finaliza carga (fecha y hora)" Style="{StaticResource FormLabelStyle}" />
        <StackPanel Orientation="Horizontal">
          <DatePicker Style="{StaticResource FormDatePickerStyle}" Width="150"
                      SelectedDate="{Binding FinCargaFecha}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}" Width="70" Margin="8,0,0,0"
                   Text="{Binding FinCargaHora, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Hora en formato HH:mm" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <TextBlock Text="La llegada al central y el pesaje los registra personal del CAM en la recepción."
               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
               TextWrapping="Wrap" Margin="0,12,0,0" />
  </StackPanel>
</UserControl>
