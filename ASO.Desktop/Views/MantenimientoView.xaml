<UserControl x:Class="ASO.Desktop.Views.MantenimientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Revisiones recomendadas -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
            Visibility="{Binding HayRecomendaciones, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="Revisiones recomendadas" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Recomendaciones}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource ChipRecomendacionStyle}"
                          VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsMicro}" />
                  </Border>

                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}">
                      <Run Text="{Binding Activo.Etiqueta, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text=" — " /><Run Text="{Binding Regla.Revision, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Detalle}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                  </StackPanel>

                  <Button Grid.Column="2" Content="Registrar" Padding="10,4" Margin="8,0,0,0"
                          Cursor="Hand" FontSize="{StaticResource FsCaption}" VerticalAlignment="Top"
                          Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                          Foreground="{DynamicResource AccentBlueBrush}"
                          Command="{Binding DataContext.RegistrarDesdeRecomendacionCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Barra de herramientas -->
    <Border Grid.Row="2" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Column="0" Width="240" VerticalAlignment="Center"
                  Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding OpcionesActivo}" DisplayMemberPath="Etiqueta"
                  SelectedItem="{Binding ActivoFiltro}" />

        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <RadioButton Content="Todos" GroupName="FiltroMantenimiento" IsChecked="True"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroTipoCommand}" CommandParameter="Todos" />
          <RadioButton Content="Preventivo" GroupName="FiltroMantenimiento"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroTipoCommand}" CommandParameter="Preventivo" />
          <RadioButton Content="Correctivo" GroupName="FiltroMantenimiento"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroTipoCommand}" CommandParameter="Correctivo" />
        </WrapPanel>

        <controls:SearchBox Grid.Column="2" Margin="12,0,0,0" Width="280" VerticalAlignment="Center"
                              Sugerencia="Buscar por activo, descripción o quién lo realizó"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Registrar mantenimiento" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding RegistrarCommand}" />
          <Button Content="Actualizar" Padding="12,6" Margin="8,0,0,0" Cursor="Hand" FontSize="{StaticResource FsBody}"
                  Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Historial -->
    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding RegistrosView}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Fecha" Width="13*" MinWidth="84"
                                   Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
            <controls:ColumnaTexto Header="Activo" Binding="{Binding ActivoEtiqueta}" Width="18*" MinWidth="120" />
            <controls:ColumnaTexto Header="Tipo" Binding="{Binding TipoTexto}" Width="9*" MinWidth="72" />
            <controls:ColumnaTexto Header="Descripción" Binding="{Binding Descripcion}" Width="20*" MinWidth="110" />
            <controls:ColumnaNumero Header="Lectura" Binding="{Binding LecturaTexto}" Width="9*" MinWidth="72" />
            <controls:ColumnaNumero Header="Costo" Binding="{Binding CostoTotalTexto}" Width="8*" MinWidth="70" />
            <controls:ColumnaTexto Header="Realizado por" Binding="{Binding RealizadoPor}" Width="16*" MinWidth="110" />
            <controls:ColumnaTexto Header="Remesa" Binding="{Binding RemesaTexto}" Width="7*" MinWidth="66" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xE90F;"
                             Titulo="No hay mantenimientos registrados"
                             Detalle="Registra el primero para empezar la hoja de vida de la unidad."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
