<UserControl x:Class="ASO.Desktop.Views.GestionFlotaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             xmlns:models="clr-namespace:ASO.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <!-- Contenido visible solo en modo tarjetas -->
    <Style x:Key="SoloTarjetasStyle" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HayDetalle}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- ================= MODO TARJETAS ================= -->
    <Grid Grid.Row="1" Style="{StaticResource SoloTarjetasStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Sugerencia="Buscar por código, placa, marca o modelo"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroTipoCommand}">
              <ComboBoxItem Content="Todos" />
              <ComboBoxItem Content="Cosechadoras" Tag="Cosechadora" />
              <ComboBoxItem Content="Tractores" Tag="Tractor" />
              <ComboBoxItem Content="Alzadoras" Tag="Alzadora" />
              <ComboBoxItem Content="Transporte" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Nuevo activo" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding NuevoActivoCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding ActivosView}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource CardButtonStyle}" Width="250" Margin="0,0,12,12"
                      Command="{Binding DataContext.AbrirDetalleCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Etiqueta}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Glifo}" Style="{StaticResource NavIconStyle}"
                               FontSize="{StaticResource FsMetric}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Codigo}" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="{Binding TipoTexto}" FontSize="{StaticResource FsCaption}"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource ChipEstadoActivoStyle}"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsMicro}" />
                    </Border>
                  </Grid>

                  <TextBlock Margin="0,10,0,0" FontSize="{StaticResource FsBody}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Marca, Mode=OneWay}" />
                    <Run Text="{Binding Modelo, Mode=OneWay}" />
                  </TextBlock>

                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Placa}" FontSize="{StaticResource FsCaption}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding UsoTexto}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Grid>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- ================= MODO DETALLE ================= -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding HayDetalle, Converter={StaticResource BoolToVis}}">
      <StackPanel>

        <!-- Cabecera del activo -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" DataContext="{Binding ActivoSeleccionado}">
              <TextBlock Text="{Binding Glifo}" Style="{StaticResource NavIconStyle}"
                         FontSize="30" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,12,0" />
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="{Binding Codigo, Mode=OneWay}" />
                    <Run Text=" — " /><Run Text="{Binding Marca, Mode=OneWay}" />
                    <Run Text="{Binding Modelo, Mode=OneWay}" />
                  </TextBlock>
                  <Border Style="{StaticResource ChipEstadoActivoStyle}" Margin="10,0,0,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding TipoTexto}" FontSize="{StaticResource FsBody}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
              <Button Content="Registrar mantenimiento" Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding RegistrarMantenimientoCommand}" />
              <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding EditarActivoCommand}" />
              <Button Content="Operativo" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding CambiarEstadoCommand}"
                      CommandParameter="{x:Static models:EstadoActivo.Operativo}" />
              <Button Content="A taller" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding CambiarEstadoCommand}"
                      CommandParameter="{x:Static models:EstadoActivo.EnTaller}" />
              <Button Content="Fuera de servicio" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding CambiarEstadoCommand}"
                      CommandParameter="{x:Static models:EstadoActivo.FueraDeServicio}" />
              <Button Content="Volver a la flota" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding CerrarDetalleCommand}" />
            </WrapPanel>
          </Grid>
        </Border>

        <!-- Indicadores rápidos -->
        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
          <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Uso actual" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding ActivoSeleccionado.UsoTexto}" FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
            <StackPanel>
              <TextBlock Text="Último mantenimiento" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding UltimoMantenimientoTexto}" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
            <StackPanel>
              <TextBlock Text="Próxima revisión" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding ProximaRevisionTexto}" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0">
            <StackPanel DataContext="{Binding ActivoSeleccionado}">
              <TextBlock Text="Año · Placa" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock FontSize="{StaticResource FsTitle}" FontWeight="SemiBold" Margin="0,6,0,0"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="{Binding Anio, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{Binding Placa, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Dos columnas: ficha + revisiones | mantenimientos + uso -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <StackPanel DataContext="{Binding ActivoSeleccionado}">
                <TextBlock Text="Ficha" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
                <TextBlock Text="Tipo" Style="{StaticResource FormLabelStyle}" Margin="0,4,0,2" />
                <TextBlock Text="{Binding TipoTexto}" FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Marca y modelo" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,2" />
                <TextBlock FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextPrimaryBrush}">
                  <Run Text="{Binding Marca, Mode=OneWay}" /> <Run Text="{Binding Modelo, Mode=OneWay}" />
                  <Run Text=" (" /><Run Text="{Binding Anio, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
                <TextBlock Text="Descripción" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Descripcion}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Notas" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Notas}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Revisiones" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Recomendaciones}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ChipRecomendacionStyle}"
                                VerticalAlignment="Top" Margin="0,2,10,0">
                          <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsMicro}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Regla.Revision}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detalle}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Últimos mantenimientos" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding UltimosMantenimientos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,6">
                        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}">
                          <Run Text="{Binding Fecha, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" />
                          <Run Text=" · " /><Run Text="{Binding TipoTexto, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Descripcion}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                          <Run Text="Costo: " /><Run Text="{Binding CostoTotalTexto, Mode=OneWay}" />
                          <Run Text=" · " /><Run Text="{Binding RealizadoPor, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Historial de uso" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />

                <Border Margin="0,0,0,8"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertBoxStyle}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ActivoSeleccionado.EsTransporte}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="El uso de las máquinas se alimentará de Telemetría y de los vales de combustible; hoy se muestran las lecturas capturadas al registrar mantenimientos." />
                </Border>

                <ItemsControl ItemsSource="{Binding HistorialUso}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding FechaTexto}" FontSize="{StaticResource FsCaption}"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBlock Text="{Binding Titulo}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Detalle}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"
                                DataContext="{Binding Remesa}"
                                Visibility="{Binding DataContext.TieneRemesa,
                                             RelativeSource={RelativeSource AncestorType=Grid},
                                             Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ChipEstadoStyle}">
                          <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsMicro}" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
