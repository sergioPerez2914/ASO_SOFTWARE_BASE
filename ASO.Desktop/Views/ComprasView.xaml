<UserControl x:Class="ASO.Desktop.Views.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             xmlns:models="clr-namespace:ASO.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <!-- Detalle tabular de la orden de compra, usado como ToolTip de fila: al bindear ToolTip a
         todo el objeto (no a un string), WPF resuelve este DataTemplate implícito por tipo cada
         vez que se muestra, en vez de compartir una única instancia de UIElement entre filas. -->
    <DataTemplate DataType="{x:Type models:OrdenCompra}">
      <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="420">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" SharedSizeGroup="ColDestino" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidad" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColPrecio" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotal" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Destino" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" />
          <TextBlock Grid.Column="1" Text="Cantidad" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="Precio" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="Subtotal" FontWeight="{StaticResource FwMedium}" HorizontalAlignment="Right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Lineas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" SharedSizeGroup="ColDestino" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidad" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColPrecio" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotal" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DestinoTexto}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding CantidadTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding PrecioUnitarioTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding SubtotalTexto}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,4" />
        <TextBlock HorizontalAlignment="Right" FontWeight="{StaticResource FwMedium}"
                   Text="{Binding MontoTotalTexto, StringFormat='Total: {0}'}" />
      </StackPanel>
    </DataTemplate>

    <!-- Mismo criterio para la Recepción: pedido vs. recibido, sin precio (la recepción no
         maneja dinero, solo cantidades). -->
    <DataTemplate DataType="{x:Type models:RecepcionMercancia}">
      <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="420">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" SharedSizeGroup="ColDestinoRecepcion" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColPedido" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColRecibido" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColDiferencia" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Destino" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" />
          <TextBlock Grid.Column="1" Text="Pedido" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="Recibido" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="Diferencia" FontWeight="{StaticResource FwMedium}" HorizontalAlignment="Right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Lineas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" SharedSizeGroup="ColDestinoRecepcion" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColPedido" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColRecibido" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColDiferencia" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DestinoTexto}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding CantidadPedidaTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding CantidadRecibidaTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding DiferenciaTexto}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Conmutador: qué hace falta pedir, y lo que ya se compró. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Requisiciones" GroupName="VistaCompras"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsRequisiciones, Mode=TwoWay}" />
      <RadioButton Content="Órdenes de compra" GroupName="VistaCompras"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsOrdenesCompra, Mode=TwoWay}" />
      <RadioButton Content="Recepciones" GroupName="VistaCompras"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsRecepciones, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource TabStripStyle}" VerticalAlignment="Bottom" />

    <!-- Requisiciones -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarRequisiciones, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding Requisiciones}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <WrapPanel Grid.Row="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroEstadoCommand}">
              <ComboBoxItem Content="Todas" />
              <ComboBoxItem Content="Borrador" />
              <ComboBoxItem Content="Enviada" />
              <ComboBoxItem Content="Atendida" />
              <ComboBoxItem Content="Anulada" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Nueva requisición" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Enviar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EnviarCommand}" />
            <Button Content="Armar orden de compra" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ArmarOrdenCompraCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaRequisiciones" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
              <controls:ColumnaTexto Header="Fecha" Width="12*" MinWidth="86"
                                     Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" />
              <controls:ColumnaTexto Header="Líneas" Binding="{Binding LineasTexto}" Width="58*" MinWidth="220" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoRequisicionStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Requisicion}"
                               Titulo="No hay requisiciones"
                               Detalle="Registra la primera requisición para identificar lo que hace falta."
                               Visibility="{Binding HasItems, ElementName=TablaRequisiciones, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- Órdenes de compra -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarOrdenesCompra, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding OrdenesCompra}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <WrapPanel Grid.Row="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroEstadoCommand}">
              <ComboBoxItem Content="Todas" />
              <ComboBoxItem Content="Borrador" />
              <ComboBoxItem Content="Aprobada" />
              <ComboBoxItem Content="Cerrada" />
              <ComboBoxItem Content="Anulada" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Aprobar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding AprobarCommand}" />
            <Button Content="Registrar recepción" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RegistrarRecepcionCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaOrdenesCompra" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="ToolTip" Value="{Binding}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
              <controls:ColumnaTexto Header="Fecha" Width="12*" MinWidth="86"
                                     Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" />
              <controls:ColumnaTexto Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="18*" MinWidth="120" />
              <controls:ColumnaTexto Header="Líneas" Binding="{Binding LineasTexto}" Width="26*" MinWidth="170" />
              <controls:ColumnaNumero Header="Cotizado" Binding="{Binding MontoCotizadoTexto}" Width="11*" MinWidth="90" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTotalTexto}" Width="11*" MinWidth="90">
                <controls:ColumnaNumero.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                  </Style>
                </controls:ColumnaNumero.ElementStyle>
              </controls:ColumnaNumero>
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoOrdenCompraStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.OrdenCompra}"
                               Titulo="No hay órdenes de compra"
                               Detalle="Se arman desde una requisición enviada, comparando precios de proveedor."
                               Visibility="{Binding HasItems, ElementName=TablaOrdenesCompra, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- Recepciones -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarRecepciones, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding Recepciones}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <WrapPanel Grid.Row="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroEstadoCommand}">
              <ComboBoxItem Content="Todas" />
              <ComboBoxItem Content="Borrador" />
              <ComboBoxItem Content="Confirmada" />
              <ComboBoxItem Content="Anulada" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Confirmar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ConfirmarCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaRecepciones" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="ToolTip" Value="{Binding}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
              <controls:ColumnaTexto Header="Fecha" Width="12*" MinWidth="86"
                                     Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" />
              <controls:ColumnaTexto Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="18*" MinWidth="120" />
              <controls:ColumnaTexto Header="Líneas" Binding="{Binding LineasTexto}" Width="30*" MinWidth="190" />
              <controls:ColumnaTexto Header="Recibido por" Binding="{Binding RecibidoPor}" Width="16*" MinWidth="110" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoRecepcionMercanciaStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Recepcion}"
                               Titulo="No hay recepciones"
                               Detalle="Se registran desde una orden de compra aprobada, con &quot;Registrar recepción&quot;."
                               Visibility="{Binding HasItems, ElementName=TablaRecepciones, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
