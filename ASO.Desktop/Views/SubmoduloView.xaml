<UserControl x:Class="ASO.Desktop.Views.SubmoduloView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="960">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado con la ruta módulo · submódulo -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo" VerticalAlignment="Top"
              Padding="12,6" Cursor="Hand" Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Submodulo.Icono}" FontFamily="{StaticResource IconFont}" FontSize="40"
                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Submódulo en construcción" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock Text="Todavía no tiene pantallas ni fuente de datos conectada."
                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                   Margin="0,4,0,0" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
