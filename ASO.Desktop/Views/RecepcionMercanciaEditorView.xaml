<UserControl x:Class="ASO.Desktop.Views.RecepcionMercanciaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="760">

  <StackPanel>
    <TextBlock Text="{Binding ResumenProveedor}" FontSize="{StaticResource FsBody}"
               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

    <TextBlock Text="Corrija la cantidad realmente recibida de cada línea; nace igual a lo pedido."
               Style="{StaticResource FormLabelStyle}" />

    <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="280" IsReadOnly="False"
              ItemsSource="{Binding Lineas}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns>
        <controls:ColumnaTexto Header="Tipo" Binding="{Binding TipoInsumoTexto}" Width="7*" MinWidth="55" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="14*" MinWidth="95" IsReadOnly="True" />
        <controls:ColumnaNumero Header="Pedido" Binding="{Binding CantidadPedidaTexto}" Width="8*" MinWidth="55" IsReadOnly="True" />
        <DataGridTextColumn Header="Recibido" Width="8*" MinWidth="55"
                             Binding="{Binding CantidadRecibida, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        <controls:ColumnaTexto Header="Diferencia" Binding="{Binding DiferenciaTexto}" Width="9*" MinWidth="65" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Marca" Binding="{Binding MarcaLubricanteNombre}" Width="11*" MinWidth="85" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Clase" Binding="{Binding ClaseLubricante}" Width="9*" MinWidth="65" IsReadOnly="True" />
        <DataGridTemplateColumn Header="Presentación" Width="14*" MinWidth="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <!-- Diésel: se elige aquí, al recibir (no hay cisterna que asignar). Lubricante:
                     ya viene fijada de la orden de compra, solo lectura. -->
                <ComboBox ItemsSource="{Binding DataContext.PresentacionesCombustible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Presentacion, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding EsDiesel, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Presentacion}" VerticalAlignment="Center"
                           Visibility="{Binding EsLubricante, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <controls:FormField Etiqueta="Notas" Margin="0,12,0,0">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <TextBlock Text="Al confirmar la recepción se suma cada línea al stock que le corresponde por lo realmente recibido, no por lo pedido."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
