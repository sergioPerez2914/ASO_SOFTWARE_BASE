<UserControl x:Class="ASO.Desktop.Views.RecepcionMercanciaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="760">

  <StackPanel>
    <TextBlock Text="{Binding ResumenProveedor}" FontSize="12"
               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

    <TextBlock Text="Corrija la cantidad realmente recibida de cada línea; nace igual a lo pedido."
               Style="{StaticResource FormLabelStyle}" />

    <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="280"
              ItemsSource="{Binding Lineas}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns>
        <controls:ColumnaTexto Header="Tipo" Binding="{Binding TipoInsumoTexto}" Width="9*" MinWidth="90" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="16*" MinWidth="120" IsReadOnly="True" />
        <controls:ColumnaNumero Header="Pedido" Binding="{Binding CantidadPedidaTexto}" Width="10*" MinWidth="86" IsReadOnly="True" />
        <DataGridTextColumn Header="Recibido" Width="10*" MinWidth="86"
                             Binding="{Binding CantidadRecibida, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        <controls:ColumnaTexto Header="Diferencia" Binding="{Binding DiferenciaTexto}" Width="12*" MinWidth="100" IsReadOnly="True" />
        <DataGridTemplateColumn Header="Stock combustible" Width="18*" MinWidth="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.StocksCombustible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        DisplayMemberPath="Nombre" SelectedValuePath="Id"
                        SelectedValue="{Binding StockCombustibleId, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding EsCombustible, Converter={StaticResource BoolToVis}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <controls:FormField Etiqueta="Recibido por" Margin="0,12,0,0">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding RecibidoPor, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Notas">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <TextBlock Text="Al confirmar la recepción se suma cada línea al stock que le corresponde por lo realmente recibido, no por lo pedido."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
