<UserControl x:Class="ASO.Desktop.Views.LineaConceptoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <TextBlock Text="{Binding Resumen}" FontSize="12" TextWrapping="Wrap"
               Foreground="{StaticResource TextSecondaryBrush}" />

    <TextBlock Text="Concepto" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding Conceptos}"
              DisplayMemberPath="Nombre"
              SelectedItem="{Binding ConceptoSeleccionado}" />

    <TextBlock Text="Monto" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="{Binding EfectoTexto}" FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
  </StackPanel>
</UserControl>
