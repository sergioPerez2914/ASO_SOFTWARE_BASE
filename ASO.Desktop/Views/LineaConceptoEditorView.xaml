<UserControl x:Class="ASO.Desktop.Views.LineaConceptoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <TextBlock Text="{Binding Resumen}" FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <controls:FormField Etiqueta="Concepto">
      <ComboBox Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding Conceptos}"
                DisplayMemberPath="Nombre"
                SelectedItem="{Binding ConceptoSeleccionado}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Monto">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <TextBlock Text="{Binding EfectoTexto}" FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
  </StackPanel>
</UserControl>
