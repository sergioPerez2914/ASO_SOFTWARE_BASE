<UserControl x:Class="ASO.Desktop.Views.TarifasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Barra de herramientas: búsqueda, filtro por ámbito y acciones -->
    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
          <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                   Command="{Binding CambiarFiltroAmbitoCommand}">
            <ComboBoxItem Content="Todas" />
            <ComboBoxItem Content="Cobro al ingenio" Tag="Cobro" />
            <ComboBoxItem Content="Pago por destajo" Tag="Pago" />
            <ComboBoxItem Content="Solo vigentes" Tag="Vigentes" />
          </controls:FiltroDropdown>
        </WrapPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,12,0,0">
          <Button Content="Nueva tarifa" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AgregarCommand}" />
          <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EditarCommand}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding EliminarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Concepto" Binding="{Binding Concepto}" Width="20*" MinWidth="130" />
            <controls:ColumnaTexto Header="Servicio" Binding="{Binding ServicioTexto}" Width="12*" MinWidth="90" />
            <controls:ColumnaTexto Header="Ámbito" Binding="{Binding AmbitoTexto}" Width="14*" MinWidth="100" />
            <controls:ColumnaTexto Header="Unidad" Binding="{Binding UnidadTexto}" Width="9*" MinWidth="72" />
            <controls:ColumnaNumero Header="Monto" Width="11*" MinWidth="84"
                                    Binding="{Binding MontoPorUnidad, StringFormat={}{0:N2}}" />
            <controls:ColumnaTexto Header="Vigencia" Binding="{Binding VigenciaTexto}" Width="16*" MinWidth="110" />
            <DataGridTemplateColumn Header="Estado" Width="92">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipVigenciaTarifaStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.Tarifas}"
                             Titulo="No hay tarifas cargadas"
                             Detalle="Sin tarifario no se puede facturar ni liquidar: carga la primera."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
