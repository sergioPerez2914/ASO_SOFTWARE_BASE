<UserControl x:Class="ASO.Desktop.Views.EmpleadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado con la ruta módulo · submódulo -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo" VerticalAlignment="Top"
              Padding="12,6" Cursor="Hand" Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <!-- Conmutador de padrón: son dos catálogos distintos, no se mezclan -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton Content="Administrativos" GroupName="PadronEmpleados" IsChecked="True"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Administrativos" />
      <RadioButton Content="Personal de campo" GroupName="PadronEmpleados"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Campo" />
    </StackPanel>

    <!-- Padrón administrativo: empleados de nómina del centro -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarAdministrativos, Converter={StaticResource BoolToVis}}">
      <!-- DataContext en un Grid interno: compartir elemento con Visibility haría que esa
           binding se resuelva contra el sub-VM (sin MostrarAdministrativos) y no contra este ViewModel. -->
      <Grid DataContext="{Binding Administrativos}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Row="0" Grid.Column="0" Width="260" VerticalAlignment="Center"
                   Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por nombre, cédula o cargo" />

          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <RadioButton Content="Todos" GroupName="FiltroEmpleado" IsChecked="True"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todos" />
            <RadioButton Content="Activos" GroupName="FiltroEmpleado"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Activos" />
            <RadioButton Content="Inactivos" GroupName="FiltroEmpleado"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Inactivos" />
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Nuevo empleado" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="240" />
            <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="120" />
            <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*" />
            <DataGridTemplateColumn Header="Estado" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipActivoStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" Foreground="White" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      </Grid>
    </Grid>

    <!-- Padrón de campo: quienes firman la remesa, con su núcleo (C.O.D) -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarCampo, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding Campo}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Row="0" Grid.Column="0" Width="260" VerticalAlignment="Center"
                   Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por nombre, cédula, rol o núcleo" />

          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <RadioButton Content="Todos" GroupName="FiltroRolCampo" IsChecked="True"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Todos" />
            <RadioButton Content="Operador" GroupName="FiltroRolCampo"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Operador" />
            <RadioButton Content="Tractorista" GroupName="FiltroRolCampo"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Tractorista" />
            <RadioButton Content="Chofer" GroupName="FiltroRolCampo"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Chofer" />
            <RadioButton Content="Remesero" GroupName="FiltroRolCampo"
                         Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Remesero" />
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Nuevo personal" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="240" />
            <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="120" />
            <DataGridTextColumn Header="Rol" Binding="{Binding RolTexto}" Width="130" />
            <DataGridTextColumn Header="Núcleo (C.O.D)" Binding="{Binding NucleoCodigo}" Width="*" />
            <DataGridTemplateColumn Header="Estado" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipActivoStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" Foreground="White" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
