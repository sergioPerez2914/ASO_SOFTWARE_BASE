<UserControl x:Class="ASO.Desktop.Views.EmpleadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Conmutador de padrón: son dos catálogos distintos, no se mezclan.

         Pestañas y no pastillas: las pastillas son el estilo de los FILTROS de la barra de
         abajo, y usarlas también aquí dibujaba igual "qué padrón miro" y "cómo lo acoto". -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Administrativos" GroupName="PadronEmpleados"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsAdministrativos, Mode=TwoWay}" />
      <RadioButton Content="Personal de campo" GroupName="PadronEmpleados"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsCampo, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom"
            Background="{DynamicResource BorderBrush}" />

    <!-- Padrón administrativo: empleados de nómina del centro -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarAdministrativos, Converter={StaticResource BoolToVis}}">
      <!-- DataContext en un Grid interno: compartir elemento con Visibility haría que esa
           binding se resuelva contra el sub-VM (sin MostrarAdministrativos) y no contra este ViewModel. -->
      <Grid DataContext="{Binding Administrativos}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Sugerencia="Buscar por nombre, cédula o cargo"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <RadioButton Content="Todos" GroupName="FiltroEmpleado" IsChecked="True"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todos" />
            <RadioButton Content="Activos" GroupName="FiltroEmpleado"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Activos" />
            <RadioButton Content="Inactivos" GroupName="FiltroEmpleado"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Inactivos" />
          </WrapPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Nuevo empleado" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla1" Style="{StaticResource DataGridStyle}" MaxHeight="480"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
              <controls:ColumnaTexto Header="Nombre" Binding="{Binding Nombre}" Width="24*" MinWidth="150" />
              <controls:ColumnaTexto Header="Cédula" Binding="{Binding Cedula}" Width="12*" MinWidth="92" />
              <controls:ColumnaTexto Header="Cargo" Binding="{Binding Cargo}" Width="18*" MinWidth="120" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipActivoStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xE716;"
                               Titulo="No hay empleados"
                               Detalle="Da de alta al personal de nómina y de taller."
                               Visibility="{Binding HasItems, ElementName=Tabla1, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- Padrón de campo: quienes firman la remesa, con su núcleo (C.O.D) -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarCampo, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding Campo}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Sugerencia="Buscar por nombre, cédula, rol o núcleo"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <RadioButton Content="Todos" GroupName="FiltroRolCampo" IsChecked="True"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Todos" />
            <RadioButton Content="Operador" GroupName="FiltroRolCampo"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Operador" />
            <RadioButton Content="Tractorista" GroupName="FiltroRolCampo"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Tractorista" />
            <RadioButton Content="Chofer" GroupName="FiltroRolCampo"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Chofer" />
            <RadioButton Content="Remesero" GroupName="FiltroRolCampo"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroRolCommand}" CommandParameter="Remesero" />
          </WrapPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Nuevo personal" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla2" Style="{StaticResource DataGridStyle}" MaxHeight="480"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
              <controls:ColumnaTexto Header="Nombre" Binding="{Binding Nombre}" Width="24*" MinWidth="150" />
              <controls:ColumnaTexto Header="Cédula" Binding="{Binding Cedula}" Width="12*" MinWidth="92" />
              <controls:ColumnaTexto Header="Rol" Binding="{Binding RolTexto}" Width="13*" MinWidth="100" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipActivoStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xE716;"
                               Titulo="No hay personal de campo"
                               Detalle="Es quien firma las remesas: da de alta al primero."
                               Visibility="{Binding HasItems, ElementName=Tabla2, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
