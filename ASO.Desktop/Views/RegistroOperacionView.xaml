<UserControl x:Class="ASO.Desktop.Views.RegistroOperacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <!-- Pantalla piloto del patron de listado. Las otras trece siguen esta misma forma:

         PageHeader con la accion principal a la derecha   (sin boton de volver: lo es la ruta)
         Barra de herramientas: busqueda + filtros          (sin tarjeta: no contiene datos)
         Acciones sobre la fila seleccionada
         Tarjeta con la tabla y su estado vacio encima      -->

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}">
      <Button Content="Nueva remesa" Style="{StaticResource PrimaryButtonStyle}"
              Command="{Binding AgregarCommand}" />
    </controls:PageHeader>

    <!-- Busqueda y filtros. Sin tarjeta: una barra de herramientas no contiene datos, los
         filtra, y envolverla en la misma caja blanca que la tabla borraba esa diferencia. -->
    <Grid Grid.Row="1" Margin="{StaticResource TkEtiqueta}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <controls:SearchBox Grid.Column="0" Width="280" VerticalAlignment="Center"
                          Sugerencia="Buscar por Nº, finca, placa, personal o núcleo"
                          Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
        <RadioButton Content="Todas" GroupName="FiltroEstado" IsChecked="True"
                     Style="{StaticResource FilterChipStyle}"
                     Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
        <RadioButton Content="Borrador" GroupName="FiltroEstado"
                     Style="{StaticResource FilterChipStyle}"
                     Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Borrador" />
        <RadioButton Content="Confirmada" GroupName="FiltroEstado"
                     Style="{StaticResource FilterChipStyle}"
                     Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Confirmada" />
        <RadioButton Content="Recibida" GroupName="FiltroEstado"
                     Style="{StaticResource FilterChipStyle}"
                     Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Recibida" />
        <RadioButton Content="Anulada" GroupName="FiltroEstado"
                     Style="{StaticResource FilterChipStyle}"
                     Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anulada" />
      </StackPanel>
    </Grid>

    <!-- Acciones sobre la remesa seleccionada. Anular va en rojo: es lo unico de aqui que no
         tiene vuelta atras. -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="{StaticResource TkEtiqueta}">
      <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding EditarCommand}" />
      <Button Content="Confirmar" Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding ConfirmarCommand}" />
      <Button Content="Registrar recepción" Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding RegistrarRecepcionCommand}" />
      <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
              Foreground="{DynamicResource DangerTextBrush}"
              Command="{Binding AnularCommand}" />
      <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
              Foreground="{DynamicResource DangerTextBrush}"
              Command="{Binding EliminarCommand}" />
      <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding RefrescarCommand}" />
    </StackPanel>

    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Inicio de carga" Width="13*" MinWidth="90"
                                   Binding="{Binding InicioCarga, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
            <controls:ColumnaTexto Header="Finca" Binding="{Binding FincaNombre}" Width="20*" MinWidth="110" />
            <controls:ColumnaTexto Header="Lote · Tablón" Binding="{Binding UbicacionTexto}" Width="18*" MinWidth="100" />
            <controls:ColumnaTexto Header="Cosecha" Binding="{Binding TipoCosechaTexto}" Width="9*" MinWidth="66" />
            <controls:ColumnaTexto Header="Placa" Binding="{Binding VehiculoPlaca}" Width="9*" MinWidth="70" />
            <controls:ColumnaNumero Header="Neto (t)" Width="8*" MinWidth="64"
                                    Binding="{Binding PesoNetoT, StringFormat={}{0:N2}}" />
            <controls:ColumnaTexto Header="Facturada" Binding="{Binding FacturadaTexto}" Width="11*" MinWidth="78" />
            <DataGridTemplateColumn Header="Estado" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipEstadoStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsMicro}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Una tabla sin filas se veia como un encabezado de columnas y espacio en blanco
             debajo, sin distinguir "todavia no hay nada" de "el filtro no encontro nada". -->
        <controls:EmptyState Icono="&#xE7C3;"
                             Titulo="No hay remesas que mostrar"
                             Detalle="Cambia el filtro o la búsqueda, o registra la primera remesa del día."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}">
          <Button Content="Nueva remesa" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AgregarCommand}" />
        </controls:EmptyState>
      </Grid>
    </Border>
  </Grid>
</UserControl>
