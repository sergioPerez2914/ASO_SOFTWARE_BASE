<UserControl x:Class="ASO.Desktop.Views.RegistroOperacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo"
              Style="{StaticResource VolverModuloButtonStyle}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <!-- Barra de herramientas: búsqueda, filtro por estado y acciones -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0" Grid.Column="0" Width="260" VerticalAlignment="Center"
                 Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Buscar por Nº, finca, placa, personal o núcleo" />

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <RadioButton Content="Todas" GroupName="FiltroEstado" IsChecked="True"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
          <RadioButton Content="Borrador" GroupName="FiltroEstado"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Borrador" />
          <RadioButton Content="Confirmada" GroupName="FiltroEstado"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Confirmada" />
          <RadioButton Content="Recibida" GroupName="FiltroEstado"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Recibida" />
          <RadioButton Content="Anulada" GroupName="FiltroEstado"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anulada" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Nueva remesa" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                  Background="{DynamicResource PrimaryBrush}" Foreground="White"
                  Command="{Binding AgregarCommand}" />
          <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding EditarCommand}" />
          <Button Content="Confirmar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding ConfirmarCommand}" />
          <Button Content="Registrar recepción" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding RegistrarRecepcionCommand}" />
          <Button Content="Anular" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding AnularCommand}" />
          <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding EliminarCommand}" />
          <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding ItemsView}"
                SelectedItem="{Binding SelectedItem}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
          <DataGridTextColumn Header="Inicio de carga" Width="130"
                              Binding="{Binding InicioCarga, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
          <DataGridTextColumn Header="Finca" Binding="{Binding FincaNombre}" Width="150" />
          <DataGridTextColumn Header="Lote · Tablón" Binding="{Binding UbicacionTexto}" Width="150" />
          <DataGridTextColumn Header="Cosecha" Binding="{Binding TipoCosechaTexto}" Width="90" />
          <DataGridTextColumn Header="Placa" Binding="{Binding VehiculoPlaca}" Width="90" />
          <DataGridTextColumn Header="Neto (t)" Width="80"
                              Binding="{Binding PesoNetoT, StringFormat={}{0:N2}}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Facturada" Binding="{Binding FacturadaTexto}" Width="110" />
          <DataGridTemplateColumn Header="Estado" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ChipEstadoStyle}">
                  <TextBlock Text="{Binding EstadoTexto}" FontSize="11" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
