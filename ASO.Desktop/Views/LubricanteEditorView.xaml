<UserControl x:Class="ASO.Desktop.Views.LubricanteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="440">

  <StackPanel>
    <controls:FormField Etiqueta="Marca">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Column="0" Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding MarcasLubricante}"
                  DisplayMemberPath="Nombre"
                  SelectedItem="{Binding MarcaSeleccionada}" />

        <Button Grid.Column="1" Style="{StaticResource BarraBotonStyle}"
                Content="+ Nuevo" ToolTip="Nueva marca de lubricante"
                Command="{Binding NuevoMarcaCommand}" />
      </Grid>
    </controls:FormField>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Tipo">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSeleccionado}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Grado de viscosidad">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Grados}" SelectedItem="{Binding GradoSeleccionado}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Existencia (litros)">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding ExistenciaLTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Costo unitario (por litro)">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding CostoUnitarioTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
      <Run Text="{Binding ValorPreviewTexto, StringFormat='Valor: {0}', Mode=OneWay}" />
    </TextBlock>

    <CheckBox Content="Activo" Margin="0,14,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />
  </StackPanel>
</UserControl>
