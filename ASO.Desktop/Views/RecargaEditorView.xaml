<UserControl x:Class="ASO.Desktop.Views.RecargaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420">

  <StackPanel>
    <TextBlock Text="Cisterna que se recarga" Style="{StaticResource FormLabelStyle}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ComboBox Grid.Column="0" Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding Tanques}"
                DisplayMemberPath="Nombre"
                SelectedItem="{Binding TanqueSeleccionado}" />

      <Button Grid.Column="1" Style="{StaticResource BarraBotonStyle}"
              Content="+ Nueva" ToolTip="Nueva cisterna"
              Command="{Binding NuevaCisternaCommand}" />
    </Grid>
    <TextBlock Text="{Binding EspacioTexto}" FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Litros recibidos" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding LitrosTexto, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Costo total (opcional)" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding CostoTexto, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <StackPanel Grid.Column="4">
        <TextBlock Text="Fecha" Style="{StaticResource FormLabelStyle}" />
        <DatePicker Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding Fecha}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Proveedor" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             Text="{Binding ProveedorNombre, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="Notas" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="La recarga suma los litros a la cisterna al guardarse: se registra cuando el combustible ya está descargado."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
