<UserControl x:Class="ASO.Desktop.Views.FincasYNucleosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado con la ruta módulo · submódulo -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo" VerticalAlignment="Top"
              Padding="12,6" Cursor="Hand" Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <!-- Conmutador de catálogo: son dos maestros distintos, no se mezclan -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton Content="Fincas" GroupName="CatalogoOperaciones" IsChecked="True"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Fincas" />
      <RadioButton Content="Núcleos" GroupName="CatalogoOperaciones"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Nucleos" />
    </StackPanel>

    <!-- Fincas: catálogo con lotes y tablones anidados -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarFincas, Converter={StaticResource BoolToVis}}">
      <!-- DataContext en un Grid interno: compartir elemento con Visibility haría que esa
           binding se resuelva contra el sub-VM (sin MostrarFincas) y no contra este ViewModel. -->
      <Grid DataContext="{Binding Fincas}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" Width="260" VerticalAlignment="Center"
                   Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por código CAM o nombre" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Nueva finca" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Código CAM" Binding="{Binding CodigoCam}" Width="140" />
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
            <DataGridTextColumn Header="Lotes" Binding="{Binding Lotes.Count}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      </Grid>
    </Grid>

    <!-- Núcleos: catálogo de productores (C.O.D) -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarNucleos, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding Nucleos}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" Width="260" VerticalAlignment="Center"
                   Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por código o nombre" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Nuevo núcleo" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Código (C.O.D)" Binding="{Binding Codigo}" Width="140" />
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
