<UserControl x:Class="ASO.Desktop.Views.ProductoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado con la ruta módulo · submódulo -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo"
              Style="{StaticResource VolverModuloButtonStyle}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <!-- Indicadores del período mostrado -->
    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Toneladas entregadas" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding ToneladasTexto}" FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource PrimaryBrush}" />
          <TextBlock Text="netas, en el período mostrado" FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Entregas" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding EntregasTexto}" FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource PrimaryBrush}" />
          <TextBlock Text="remesas recibidas en el central" FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Toneladas de hoy" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding ToneladasHoyTexto}" FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource PrimaryBrush}" />
          <TextBlock Text="entregadas en la jornada" FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Sin facturar" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding SinFacturarTexto}" FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource WarningBrush}" />
          <TextBlock Text="toneladas pendientes de cobro" FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Barra: búsqueda y rango -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" Width="260" VerticalAlignment="Center"
                 Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Buscar por finca, lote o núcleo de transporte" />

        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <RadioButton Content="Todo" GroupName="RangoProducto" IsChecked="True"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarRangoCommand}" CommandParameter="Todo" />
          <RadioButton Content="Últimos 7 días" GroupName="RangoProducto"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarRangoCommand}" CommandParameter="Semana" />
          <RadioButton Content="Hoy" GroupName="RangoProducto"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarRangoCommand}" CommandParameter="Hoy" />
          <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource CardStyle}">
      <DataGrid Style="{StaticResource DataGridStyle}" IsReadOnly="True"
                ItemsSource="{Binding EntregasView}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Remesa" Binding="{Binding RemesaId}" Width="80" />
          <DataGridTextColumn Header="Entregada" Binding="{Binding FechaTexto}" Width="140" />
          <DataGridTextColumn Header="Finca" Binding="{Binding FincaNombre}" Width="200" />
          <DataGridTextColumn Header="Lote · Tablón" Binding="{Binding Ubicacion}" Width="180" />
          <DataGridTextColumn Header="Toneladas" Binding="{Binding ToneladasTexto}" Width="*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Facturación" Binding="{Binding FacturadaTexto}" Width="130" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
