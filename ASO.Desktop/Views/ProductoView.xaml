<UserControl x:Class="ASO.Desktop.Views.ProductoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Indicadores del período mostrado -->
    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Toneladas entregadas" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding ToneladasTexto}" FontSize="{StaticResource FsMetric}" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}" />
          <TextBlock Text="netas, en el período mostrado" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Entregas" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding EntregasTexto}" FontSize="{StaticResource FsMetric}" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}" />
          <TextBlock Text="remesas recibidas en el central" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Toneladas de hoy" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding ToneladasHoyTexto}" FontSize="{StaticResource FsMetric}" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}" />
          <TextBlock Text="entregadas en la jornada" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Sin facturar" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding SinFacturarTexto}" FontSize="{StaticResource FsMetric}" FontWeight="Bold"
                     Foreground="{DynamicResource WarningBrush}" />
          <TextBlock Text="toneladas pendientes de cobro" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Barra: búsqueda y rango -->
    <Border Grid.Row="2" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:SearchBox Grid.Column="0" Width="280" VerticalAlignment="Center"
                              Sugerencia="Buscar por finca, lote o núcleo de transporte"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <RadioButton Content="Todo" GroupName="RangoProducto" IsChecked="True"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarRangoCommand}" CommandParameter="Todo" />
          <RadioButton Content="Últimos 7 días" GroupName="RangoProducto"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarRangoCommand}" CommandParameter="Semana" />
          <RadioButton Content="Hoy" GroupName="RangoProducto"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarRangoCommand}" CommandParameter="Hoy" />
          <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}" IsReadOnly="True"
                  ItemsSource="{Binding EntregasView}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Remesa" Binding="{Binding RemesaId}" Width="80" />
            <DataGridTextColumn Header="Entregada" Binding="{Binding FechaTexto}" Width="140" />
            <DataGridTextColumn Header="Finca" Binding="{Binding FincaNombre}" Width="200" />
            <DataGridTextColumn Header="Lote · Tablón" Binding="{Binding Ubicacion}" Width="180" />
            <DataGridTextColumn Header="Toneladas" Binding="{Binding ToneladasTexto}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Facturación" Binding="{Binding FacturadaTexto}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xEAFC;"
                             Titulo="No hay producción que mostrar"
                             Detalle="Los datos salen de las remesas recibidas en el central."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
