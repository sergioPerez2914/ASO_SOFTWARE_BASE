<UserControl x:Class="ASO.Desktop.Views.CompararProveedoresEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="940">

  <StackPanel>
    <TextBlock Text="{Binding Requisicion.LineasTexto}" TextWrapping="Wrap"
               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

    <TextBlock Text="Cotizar proveedor" Style="{StaticResource FormLabelStyle}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Proveedor">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Style="{StaticResource FormComboBoxStyle}"
                      ItemsSource="{Binding Proveedores}"
                      DisplayMemberPath="Etiqueta"
                      SelectedItem="{Binding ProveedorLineaSeleccionado}" />

            <Button Grid.Column="1" Style="{StaticResource BarraBotonStyle}"
                    Content="+ Nuevo" ToolTip="Nuevo proveedor"
                    Command="{Binding NuevoProveedorCommand}" />
          </Grid>
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Notas (opcional)">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding NotasLineaTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <TextBlock Text="Complete el detalle como en una factura. En lubricante, primero elija marca, clase y presentación (el envase), y diga cuántas unidades de ese envase compra: el precio es por envase, y el total se calcula solo."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4" />

    <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="260" IsReadOnly="False"
              ItemsSource="{Binding LineasCotizacion}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns>
        <controls:ColumnaTexto Header="Tipo" Binding="{Binding TipoInsumoTexto}" Width="6*" MinWidth="60" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="14*" MinWidth="110" IsReadOnly="True" />
        <controls:ColumnaNumero Header="Pedido (L)" Binding="{Binding CantidadTexto}" Width="8*" MinWidth="70" IsReadOnly="True" />
        <DataGridTemplateColumn Header="Marca" Width="16*" MinWidth="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding DataContext.MarcasLubricante, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Nombre" SelectedValuePath="Id"
                          SelectedValue="{Binding MarcaLubricanteId, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding EsLubricante, Converter={StaticResource BoolToVis}}" />
                <Button Content="+ Nuevo" Style="{StaticResource BarraBotonStyle}" Margin="4,0,0,0"
                        Visibility="{Binding EsLubricante, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.NuevoMarcaCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Clase" Width="10*" MinWidth="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.ClasesLubricante, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedItem="{Binding ClaseLubricante, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding EsLubricante, Converter={StaticResource BoolToVis}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Presentación" Width="11*" MinWidth="95">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.Presentaciones, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedItem="{Binding Presentacion, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding EsLubricante, Converter={StaticResource BoolToVis}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Unidades" Width="9*" MinWidth="75">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Unidades, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                       Visibility="{Binding EsLubricante, Converter={StaticResource BoolToVis}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Precio/envase (USD)" Width="12*" MinWidth="95"
                             Binding="{Binding PrecioUnitario, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="11*" MinWidth="90" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding TotalLineasCotizacionTexto, StringFormat='Total: US$ {0}'}"
                 FontWeight="{StaticResource FwMedium}" />

      <Button Grid.Column="1" Content="Agregar cotización" Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding AgregarCotizacionCommand}" />
    </Grid>

    <TextBlock Text="Cotizaciones capturadas — seleccione la fila ganadora" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,4" />

    <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="180"
              ItemsSource="{Binding Cotizaciones}"
              SelectedItem="{Binding GanadoraSeleccionada}" IsReadOnly="True">
      <DataGrid.Columns>
        <controls:ColumnaTexto Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="24*" MinWidth="140" />
        <controls:ColumnaNumero Header="Monto (USD)" Binding="{Binding MontoTexto}" Width="12*" MinWidth="90" />
        <controls:ColumnaTexto Header="Notas" Binding="{Binding Notas}" Width="22*" MinWidth="120" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Text="La fila seleccionada en la grilla es la cotización ganadora. Cada cotización queda registrada, con su detalle, al agregarla, aunque al final no se arme la orden en este momento."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />

    <StackPanel Visibility="{Binding HayGanadora, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
      <TextBlock Text="Detalle de la cotización ganadora" Style="{StaticResource FormLabelStyle}" />

      <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="220" IsReadOnly="True"
                ItemsSource="{Binding LineasGanadora}" AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserDeleteRows="False">
        <DataGrid.Columns>
          <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="16*" MinWidth="120" />
          <controls:ColumnaTexto Header="Marca" Binding="{Binding MarcaLubricanteNombre}" Width="14*" MinWidth="110" />
          <controls:ColumnaTexto Header="Clase" Binding="{Binding ClaseLubricante}" Width="9*" MinWidth="85" />
          <controls:ColumnaTexto Header="Presentación" Binding="{Binding Presentacion}" Width="11*" MinWidth="95" />
          <controls:ColumnaNumero Header="Unidades" Binding="{Binding UnidadesTexto}" Width="10*" MinWidth="80" />
          <controls:ColumnaNumero Header="Precio/envase" Binding="{Binding PrecioUnitarioTexto}" Width="11*" MinWidth="90" />
          <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="10*" MinWidth="85" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="{Binding GanadoraSeleccionada.MontoTexto, StringFormat='Total: US$ {0}'}"
                 FontWeight="{StaticResource FwMedium}" Margin="0,8,0,0" />

      <TextBlock Text="Ya está completo: viene tal cual se cargó al cotizar a este proveedor."
                 FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
