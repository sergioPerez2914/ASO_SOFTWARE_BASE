<UserControl x:Class="ASO.Desktop.Views.CompararProveedoresEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="940">

  <StackPanel>
    <TextBlock Text="{Binding Requisicion.LineasTexto}" TextWrapping="Wrap"
               FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

    <Border Style="{StaticResource SectionCardStyle}" BorderBrush="{DynamicResource PrimaryBrush}"
            BorderThickness="2" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="¿Cuándo dejar de agregar líneas?" FontSize="{StaticResource FsSubtitle}"
                   FontWeight="{StaticResource FwBold}" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Cuando el chip de cada necesidad diga &quot;Completo&quot;, ya no hace falta agregar más líneas contra ella."
                   FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8" />

        <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="140" IsReadOnly="True"
                  ItemsSource="{Binding NecesidadesCobertura}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Necesidad" Binding="{Binding DestinoTexto}" Width="34*" MinWidth="170" />
            <controls:ColumnaTexto Header="Pedido" Binding="{Binding PedidoTexto}" Width="17*" MinWidth="90" />
            <controls:ColumnaTexto Header="Cubierto" Binding="{Binding CubiertoTexto}" Width="17*" MinWidth="90" />
            <DataGridTemplateColumn Header="Estado" Width="18*" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipCoberturaStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontWeight="{StaticResource FwMedium}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <TextBlock Text="Cotizar proveedor" Style="{StaticResource FormLabelStyle}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Proveedor">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Style="{StaticResource FormComboBoxStyle}"
                      ItemsSource="{Binding Proveedores}"
                      DisplayMemberPath="Etiqueta"
                      SelectedItem="{Binding ProveedorLineaSeleccionado}" />

            <Button Grid.Column="1" Style="{StaticResource BarraBotonStyle}"
                    Content="+ Nuevo" ToolTip="Nuevo proveedor"
                    Command="{Binding NuevoProveedorCommand}" />
          </Grid>
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Notas (opcional)">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding NotasLineaTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <TextBlock Text="Agregar línea" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,4" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Necesidad (de la requisición)">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Requisicion.Lineas}"
                    DisplayMemberPath="DestinoTexto"
                    SelectedItem="{Binding NecesidadSeleccionada}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <!-- Lubricante: marca, clase, presentación, litros/envase y envases — todo lo que hace falta
         para comprar se define aquí, no al recibir. -->
    <Grid Visibility="{Binding EsNecesidadLubricante, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Marca">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Style="{StaticResource FormComboBoxStyle}"
                      ItemsSource="{Binding MarcasLubricante}"
                      DisplayMemberPath="Nombre"
                      SelectedItem="{Binding MarcaLineaSeleccionada}" />
            <Button Grid.Column="1" Content="+ Nuevo" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding NuevoMarcaCommand}" />
          </Grid>
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Clase">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding ClasesLubricante}"
                    SelectedItem="{Binding ClaseLubricanteLineaSeleccionada}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="4">
        <controls:FormField Etiqueta="Presentación">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Presentaciones}"
                    SelectedItem="{Binding PresentacionLineaSeleccionada}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <!-- Envases y litros por envase: opcionales, y solo entre los dos — si se completan ambos y
         se deja Cantidad vacío, "Agregar línea" calcula la cantidad sola. -->
    <Grid Visibility="{Binding EsNecesidadLubricante, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Envases (opcional)">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding UnidadesLineaTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Litros que trae cada envase (opcional)">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding LitrosPorEnvaseLineaTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding EquivalenciaLineaTexto}" Margin="0,0,0,8"
                   FontWeight="{StaticResource FwMedium}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </Grid>

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="{Binding EtiquetaCantidadLinea}">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding CantidadLineaTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
        <Button Content="Agregar línea" Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding AgregarLineaCotizacionCommand}" Margin="0,0,0,4" />
      </StackPanel>
    </Grid>

    <TextBlock Text="No hace falta que la cantidad de cada línea iguale lo pedido: una misma necesidad puede cubrirse con varias líneas (distinta marca o presentación). El precio se completa abajo, por línea."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,4" />

    <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="220" IsReadOnly="False"
              ItemsSource="{Binding LineasCotizacion}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns>
        <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="16*" MinWidth="120" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Marca" Binding="{Binding MarcaLubricanteNombre}" Width="14*" MinWidth="100" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Clase" Binding="{Binding ClaseLubricante}" Width="10*" MinWidth="85" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Presentación" Binding="{Binding Presentacion}" Width="12*" MinWidth="95" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Envases" Binding="{Binding UnidadesTexto}" Width="10*" MinWidth="85" IsReadOnly="True" />
        <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="11*" MinWidth="85" IsReadOnly="True" />
        <DataGridTextColumn Header="Precio/L (USD)" Width="11*" MinWidth="90"
                             Binding="{Binding PrecioUnitario, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="10*" MinWidth="85" IsReadOnly="True" />
        <DataGridTemplateColumn Width="65">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Quitar" Style="{StaticResource BarraBotonStyle}"
                      Foreground="{DynamicResource DangerTextBrush}"
                      Command="{Binding DataContext.QuitarLineaCotizacionCommand,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding TotalLineasCotizacionTexto, StringFormat='Total: US$ {0}'}"
                 FontWeight="{StaticResource FwMedium}" />

      <Button Grid.Column="1" Content="Agregar cotización" Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding AgregarCotizacionCommand}" />
    </Grid>

    <TextBlock Text="Cotizaciones capturadas — seleccione la fila ganadora" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,4" />

    <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="180"
              ItemsSource="{Binding Cotizaciones}"
              SelectedItem="{Binding GanadoraSeleccionada}" IsReadOnly="True">
      <DataGrid.Columns>
        <controls:ColumnaTexto Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="24*" MinWidth="140" />
        <controls:ColumnaNumero Header="Monto (USD)" Binding="{Binding MontoTexto}" Width="12*" MinWidth="90" />
        <controls:ColumnaTexto Header="Notas" Binding="{Binding Notas}" Width="22*" MinWidth="120" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Text="La fila seleccionada en la grilla es la cotización ganadora. Cada cotización queda registrada, con su detalle, al agregarla, aunque al final no se arme la orden en este momento."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />

    <StackPanel Visibility="{Binding HayGanadora, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
      <TextBlock Text="Detalle de la cotización ganadora" Style="{StaticResource FormLabelStyle}" />

      <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="220" IsReadOnly="True"
                ItemsSource="{Binding LineasGanadora}" AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserDeleteRows="False">
        <DataGrid.Columns>
          <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="16*" MinWidth="120" />
          <controls:ColumnaTexto Header="Marca" Binding="{Binding MarcaLubricanteNombre}" Width="13*" MinWidth="100" />
          <controls:ColumnaTexto Header="Clase" Binding="{Binding ClaseLubricante}" Width="9*" MinWidth="80" />
          <controls:ColumnaTexto Header="Presentación" Binding="{Binding Presentacion}" Width="11*" MinWidth="90" />
          <controls:ColumnaTexto Header="Envases" Binding="{Binding UnidadesTexto}" Width="9*" MinWidth="80" />
          <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="10*" MinWidth="85" />
          <controls:ColumnaNumero Header="Precio/L" Binding="{Binding PrecioUnitarioTexto}" Width="10*" MinWidth="85" />
          <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="10*" MinWidth="85" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="{Binding GanadoraSeleccionada.MontoTexto, StringFormat='Total: US$ {0}'}"
                 FontWeight="{StaticResource FwMedium}" Margin="0,8,0,0" />

      <TextBlock Text="Ya está completo: viene tal cual se cargó al cotizar a este proveedor."
                 FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
