<UserControl x:Class="ASO.Desktop.Views.GenerarLiquidacionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="440">

  <StackPanel>
    <TextBlock Text="A quién se liquida" Style="{StaticResource FormLabelStyle}" />
    <StackPanel Orientation="Horizontal">
      <RadioButton Content="Núcleo (destajo)" GroupName="SujetoLiquidacion" Margin="0,0,8,0"
                   Style="{StaticResource RangeToggleStyle}"
                   IsChecked="{Binding EsNucleo, Mode=OneWay}"
                   Command="{Binding CambiarSujetoCommand}" CommandParameter="Nucleo" />
      <RadioButton Content="Empleado (horas)" GroupName="SujetoLiquidacion"
                   Style="{StaticResource RangeToggleStyle}"
                   IsChecked="{Binding EsEmpleado, Mode=OneWay}"
                   Command="{Binding CambiarSujetoCommand}" CommandParameter="Empleado" />
    </StackPanel>

    <StackPanel Visibility="{Binding EsNucleo, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="Núcleo" Style="{StaticResource FormLabelStyle}" />
      <TextBlock Text="{Binding NucleoTexto, Mode=OneWay}"
                 Style="{StaticResource FormValorCalculadoStyle}" />
    </StackPanel>

    <StackPanel Visibility="{Binding EsEmpleado, Converter={StaticResource BoolToVis}}">
      <controls:FormField Etiqueta="Empleado">
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Empleados}"
                  DisplayMemberPath="Nombre"
                  SelectedItem="{Binding EmpleadoSeleccionado}" />
      </controls:FormField>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Desde">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Desde}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Hasta">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Hasta}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <TextBlock Text="{Binding AyudaSujeto}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />

    <TextBlock Text="Las remesas ya incluidas en otra liquidación no se vuelven a contar."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
  </StackPanel>
</UserControl>
