<UserControl x:Class="ASO.Desktop.Views.FincaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="600">

  <UserControl.Resources>
    <Style x:Key="MiniBotonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <controls:FormField Etiqueta="Código CAM">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding CodigoCam, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Nombre">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="140" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Dueño">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Dueno, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Hectáreas">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding HectareasTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Lotes y tablones" Style="{StaticResource FormLabelStyle}"
                 VerticalAlignment="Center" Margin="0" />
      <Button Grid.Column="1" Content="+ Agregar lote" Style="{StaticResource MiniBotonStyle}"
              Command="{Binding AgregarLoteCommand}" />
    </Grid>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadSm}" Margin="0,8,0,0">
      <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Lotes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" Margin="0"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nombre del lote" />
                    <Button Grid.Column="1" Content="Quitar lote" Style="{StaticResource MiniBotonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding DataContext.EliminarLoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Tablones}" Margin="16,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" Margin="0"
                                   Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTip="Nombre del tablón" />
                          <Button Grid.Column="1" Content="Quitar" Style="{StaticResource MiniBotonStyle}"
                                  Margin="8,0,0,0"
                                  Command="{Binding DataContext.EliminarTablonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Content="+ Agregar tablón" Style="{StaticResource MiniBotonStyle}"
                          HorizontalAlignment="Left" Margin="16,4,0,0"
                          Command="{Binding AgregarTablonCommand}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Text="Un lote sin tablones o una finca sin lotes se pueden completar más adelante; no bloquea el guardado."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
