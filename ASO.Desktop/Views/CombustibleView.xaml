<UserControl x:Class="ASO.Desktop.Views.CombustibleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Estado de las cisternas: lo primero que se mira antes de despachar -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tanques}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource CardStyle}" Width="280" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource FsSubtitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding ExistenciaTexto}" FontSize="{StaticResource FsDisplay}" FontWeight="Bold"
                         Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" />
              <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                           Value="{Binding PorcentajeLleno, Mode=OneWay}"
                           Background="{DynamicResource BorderBrush}"
                           Foreground="{DynamicResource AccentBlueBrush}"
                           BorderThickness="0" />
              <TextBlock Text="{Binding PorcentajeTexto}" FontSize="{StaticResource FsCaption}" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Barra de herramientas: búsqueda, filtro por estado y acciones -->
    <Border Grid.Row="2" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <controls:SearchBox Width="280" VerticalAlignment="Center"
                              Sugerencia="Buscar por activo, cisterna o responsable"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />
          <TextBlock Text="{Binding RendimientoTexto}" FontSize="{StaticResource FsBody}" Margin="16,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <RadioButton Content="Todos" GroupName="FiltroVale" IsChecked="True"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todos" />
          <RadioButton Content="Borrador" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Borrador" />
          <RadioButton Content="Confirmado" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Confirmado" />
          <RadioButton Content="Anulado" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anulado" />
          <RadioButton Content="Con alerta" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Alerta" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Nuevo vale" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AgregarCommand}" />
          <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EditarCommand}" />
          <Button Content="Confirmar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding ConfirmarCommand}" />
          <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding AnularCommand}" />
          <Button Content="Registrar recarga" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RegistrarRecargaCommand}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EliminarCommand}" />
          <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Fecha" Width="10*" MinWidth="82"
                                   Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" />
            <controls:ColumnaTexto Header="Activo" Binding="{Binding ActivoEtiqueta}" Width="20*" MinWidth="120" />
            <controls:ColumnaTexto Header="Cisterna" Binding="{Binding TanqueNombre}" Width="15*" MinWidth="100" />
            <controls:ColumnaNumero Header="Litros" Binding="{Binding LitrosTexto}" Width="9*" MinWidth="72" />
            <controls:ColumnaNumero Header="Lectura" Binding="{Binding LecturaTexto}" Width="10*" MinWidth="76" />
            <DataGridTemplateColumn Header="Consumo" Width="14*" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ConsumoTexto}" FontSize="{StaticResource FsBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Consumo alto" FontSize="{StaticResource FsCaption}" Margin="8,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AlertaConsumo}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Estado" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipEstadoValeStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xEB42;"
                             Titulo="No hay vales de combustible"
                             Detalle="Los vales aparecen aquí al despachar desde una cisterna."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
