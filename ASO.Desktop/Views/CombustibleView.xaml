<UserControl x:Class="ASO.Desktop.Views.CombustibleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Conmutador: los vales despachados y el catálogo de lubricantes. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Vales" GroupName="VistaCombustible"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsVales, Mode=TwoWay}" />
      <RadioButton Content="Lubricantes" GroupName="VistaCombustible"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsLubricantes, Mode=TwoWay}" />
      <RadioButton Content="Combustible" GroupName="VistaCombustible"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsCombustibleRecibido, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom"
            Background="{DynamicResource BorderBrush}" />

    <!-- Vales de combustible -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarVales, Converter={StaticResource BoolToVis}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Barra de herramientas: búsqueda, filtro por estado y acciones -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
          <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                              Sugerencia="Buscar por activo, stock de combustible o responsable"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <RadioButton Content="Todos" GroupName="FiltroVale" IsChecked="True"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todos" />
          <RadioButton Content="Borrador" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Borrador" />
          <RadioButton Content="Confirmado" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Confirmado" />
          <RadioButton Content="Anulado" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anulado" />
          <RadioButton Content="Con alerta" GroupName="FiltroVale"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Alerta" />
        </WrapPanel>

        <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                   Text="{Binding RendimientoTexto}" FontSize="{StaticResource FsBody}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- Alta, edicion, transiciones y por ultimo lo destructivo. "Registrar recarga" iba
             DESPUES de "Anular", que rompia la regla justo donde mas se nota. -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,12,0,0">
          <Button Content="Nuevo vale" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AgregarCommand}" />
          <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EditarCommand}" />
          <Button Content="Confirmar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding ConfirmarCommand}" />
          <Button Content="Registrar recarga" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RegistrarRecargaCommand}" />
          <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding AnularCommand}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding EliminarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Fecha" Width="10*" MinWidth="82"
                                   Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" />
            <controls:ColumnaTexto Header="Activo" Binding="{Binding ActivoEtiqueta}" Width="20*" MinWidth="120" />
            <controls:ColumnaTexto Header="Stock" Binding="{Binding StockCombustibleNombre}" Width="15*" MinWidth="100" />
            <controls:ColumnaNumero Header="Litros" Binding="{Binding LitrosTexto}" Width="9*" MinWidth="72" />
            <controls:ColumnaNumero Header="Lectura" Binding="{Binding LecturaTexto}" Width="10*" MinWidth="76" />
            <DataGridTemplateColumn Header="Consumo" Width="14*" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ConsumoTexto}" FontSize="{StaticResource FsBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Consumo alto" FontSize="{StaticResource FsCaption}" Margin="8,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AlertaConsumo}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Estado" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipEstadoValeStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xEB42;"
                             Titulo="No hay vales de combustible"
                             Detalle="Los vales aparecen aquí al despachar desde un stock de combustible."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
    </Grid>

    <!-- Catálogo de lubricantes -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarLubricantes, Converter={StaticResource BoolToVis}}">
    <Grid DataContext="{Binding Lubricantes}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding TituloValorTexto}" FontSize="{StaticResource FsSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding ValorMostradoTexto}" FontSize="{StaticResource FsDisplay}" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <controls:SearchBox Grid.Row="0" Width="280" HorizontalAlignment="Left"
                              Sugerencia="Buscar por marca, tipo o grado"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Nuevo lubricante" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaLubricantes" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Marca" Binding="{Binding MarcaLubricanteNombre}" Width="24*" MinWidth="120" />
              <controls:ColumnaTexto Header="Tipo" Binding="{Binding Tipo}" Width="18*" MinWidth="100" />
              <controls:ColumnaTexto Header="Grado" Binding="{Binding GradoViscosidad}" Width="15*" MinWidth="80" />
              <controls:ColumnaNumero Header="Existencia" Binding="{Binding ExistenciaTexto}" Width="16*" MinWidth="90" />
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xE7B8;"
                               Titulo="No hay lubricantes en el catálogo"
                               Detalle="Da de alta una marca, tipo y grado para controlar su existencia."
                               Visibility="{Binding HasItems, ElementName=TablaLubricantes, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
    </Grid>

    <!-- Diésel: cuánto tiene la empresa y el historial de litros recibidos por Compras. De solo
         lectura — todo nace de una recepción de mercancía confirmada. -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarCombustibleRecibido, Converter={StaticResource BoolToVis}}">
    <Grid DataContext="{Binding CombustibleRecibido}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Diésel en existencia" FontSize="{StaticResource FsSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding ExistenciaTotalTexto}" FontSize="{StaticResource FsDisplay}" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" />
          <TextBlock Text="Sin especificar en qué envase está." FontSize="{StaticResource FsCaption}" Margin="0,4,0,0"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaCombustibleRecibido" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding Recibos}" IsReadOnly="True">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="12*" MinWidth="82" />
              <controls:ColumnaTexto Header="Presentación" Binding="{Binding Presentacion}" Width="18*" MinWidth="110" />
              <controls:ColumnaNumero Header="Litros" Binding="{Binding LitrosTexto}" Width="12*" MinWidth="80" />
              <controls:ColumnaTexto Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="20*" MinWidth="120" />
              <controls:ColumnaTexto Header="Orden de compra" Binding="{Binding OrdenTexto}" Width="14*" MinWidth="95" />
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xEB42;"
                               Titulo="No hay recepciones de diésel"
                               Detalle="Los litros recibidos aparecen aquí al confirmar una recepción de mercancía de diésel."
                               Visibility="{Binding HasItems, ElementName=TablaCombustibleRecibido, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
    </Grid>
  </Grid>
</UserControl>
