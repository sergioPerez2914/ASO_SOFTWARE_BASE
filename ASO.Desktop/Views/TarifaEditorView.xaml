<UserControl x:Class="ASO.Desktop.Views.TarifaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="440">

  <StackPanel>
    <controls:FormField Etiqueta="Concepto">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <Grid Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Servicio">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Servicios}" SelectedItem="{Binding Servicio}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Ámbito">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Ambitos}" SelectedItem="{Binding Ambito}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <TextBlock Text="Cobro = lo que se le factura al ingenio. Pago por destajo = lo que se le paga al núcleo o al trabajador."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Unidad">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Unidades}" SelectedItem="{Binding Unidad}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Monto por unidad">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Vigente desde">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding VigenteDesde}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Vigente hasta (opcional)">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding VigenteHasta}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <TextBlock Text="Sin fecha de fin, la tarifa rige indefinidamente. Las facturas y liquidaciones ya emitidas conservan el monto que se les aplicó."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />

    <controls:FormField Etiqueta="Notas">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <CheckBox Content="Activa" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activa}" />
  </StackPanel>
</UserControl>
