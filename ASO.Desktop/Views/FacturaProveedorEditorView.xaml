<UserControl x:Class="ASO.Desktop.Views.FacturaProveedorEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="460">

  <StackPanel>
    <TextBlock Text="Proveedor" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding Proveedores}"
              DisplayMemberPath="Etiqueta"
              SelectedItem="{Binding ProveedorSeleccionado}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Nº de documento" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="El número que trae la factura del proveedor" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Monto" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Descripción" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Fecha de emisión" Style="{StaticResource FormLabelStyle}" />
        <DatePicker Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaEmision}" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Vencimiento" Style="{StaticResource FormLabelStyle}" />
        <DatePicker Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaVencimiento}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Pasado el vencimiento, la factura aparece como vencida en el listado y en el resumen del módulo."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
