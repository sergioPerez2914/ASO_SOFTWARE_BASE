<UserControl x:Class="ASO.Desktop.Views.CuentasPorCobrarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">


  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Los dos padrones: lo ya facturado y lo que espera factura. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Facturas" GroupName="VistaCxC"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsFacturas, Mode=TwoWay}" />
      <RadioButton Content="{Binding PendientesTexto}" GroupName="VistaCxC"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsPendientes, Mode=TwoWay}" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource TabStripStyle}" VerticalAlignment="Bottom" />

    <!-- Barra de herramientas: búsqueda, filtro por estado y acciones -->
    <Border Grid.Row="2" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                   Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}">
          <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                   Command="{Binding CambiarFiltroEstadoCommand}">
            <ComboBoxItem Content="Todas" />
            <ComboBoxItem Content="Borrador" />
            <ComboBoxItem Content="Emitida" />
            <ComboBoxItem Content="Vencida" />
            <ComboBoxItem Content="Cobrada" />
            <ComboBoxItem Content="Anulada" />
          </controls:FiltroDropdown>
        </WrapPanel>

        <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                   Text="{Binding ResumenCartera}" FontSize="{StaticResource FsBody}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,12,0,0">
          <Button Content="Generar factura" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding GenerarCommand}" />
          <Button Content="Emitir" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EmitirCommand}"
                  Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}" />
          <Button Content="Registrar cobro" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RegistrarCobroCommand}"
                  Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}" />
          <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding AnularCommand}"
                  Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding EliminarCommand}"
                  Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0"
            Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Factura" Binding="{Binding NumeroTexto}" Width="9*" MinWidth="76" />
            <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteNombre}" Width="25*" MinWidth="140" />
            <controls:ColumnaTexto Header="Remesas" Binding="{Binding RemesasTexto}" Width="10*" MinWidth="76" />
            <controls:ColumnaNumero Header="Toneladas" Width="10*" MinWidth="76"
                                    Binding="{Binding Toneladas, StringFormat={}{0:N2}}" />
            <controls:ColumnaTexto Header="Emisión" Binding="{Binding EmisionTexto}" Width="10*" MinWidth="82" />
            <controls:ColumnaTexto Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="11*" MinWidth="82" />
            <controls:ColumnaNumero Header="Total" Binding="{Binding TotalTexto}" Width="13*" MinWidth="92">
              <controls:ColumnaNumero.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                </Style>
              </controls:ColumnaNumero.ElementStyle>
            </controls:ColumnaNumero>
            <DataGridTemplateColumn Header="Estado" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipEstadoFacturaClienteStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.CuentasPorCobrar}"
                             Titulo="No hay facturas al ingenio"
                             Detalle="Se generan a partir de las remesas recibidas y no facturadas."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>

    <!-- Remesas cerradas que todavía esperan factura: esto es dinero por cobrar, no una lista de
         operaciones. La diferencia es contra el tarifario, según el boleto con que se cerró. -->
    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0"
            Visibility="{Binding MostrarPendientes, Converter={StaticResource BoolToVis}}">
      <Grid>
        <DataGrid x:Name="TablaPendientes" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding RemesasPorFacturar}" IsReadOnly="True">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Remesa" Binding="{Binding Id}" Width="8*" MinWidth="72" />
            <controls:ColumnaTexto Header="Recibida" Binding="{Binding FechaTexto}" Width="11*" MinWidth="82" />
            <controls:ColumnaTexto Header="Finca" Binding="{Binding FincaNombre}" Width="22*" MinWidth="130" />
            <controls:ColumnaTexto Header="Boleto" Binding="{Binding BoletoTexto}" Width="11*" MinWidth="82" />
            <controls:ColumnaNumero Header="Neto (t)" Binding="{Binding ToneladasTexto}" Width="11*" MinWidth="76" />
            <controls:ColumnaNumero Header="Según tarifario" Binding="{Binding CobroEstimadoTexto}" Width="13*" MinWidth="96" />
            <controls:ColumnaNumero Header="Según boleto" Binding="{Binding DeclaradoTexto}" Width="13*" MinWidth="96" />
            <controls:ColumnaNumero Header="Diferencia" Binding="{Binding DiferenciaTexto}" Width="12*" MinWidth="88">
              <controls:ColumnaNumero.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                  <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Cuadra}" Value="True">
                      <Setter Property="FontWeight" Value="Normal" />
                      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </controls:ColumnaNumero.ElementStyle>
            </controls:ColumnaNumero>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.CuentasPorCobrar}"
                             Titulo="No hay remesas esperando factura"
                             Detalle="Las remesas aparecen aquí al cerrarlas con el boleto del central, en Operaciones · Registro de Operación."
                             Visibility="{Binding HasItems, ElementName=TablaPendientes, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>

    <!-- Detalle: las líneas de la factura seleccionada -->
    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,12,0,0"
            Visibility="{Binding HayDetalle, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="Detalle de la factura"
                     Style="{StaticResource CardTitleStyle}" />
          <TextBlock Grid.Column="1" Text="{Binding TotalesTexto}" FontSize="{StaticResource FsBody}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="180" Margin="0,8,0,0"
                  ItemsSource="{Binding SelectedItem.Lineas}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Remesa" Binding="{Binding RemesaTexto}" Width="8*" MinWidth="72" />
            <controls:ColumnaTexto Header="Finca" Binding="{Binding FincaNombre}" Width="18*" MinWidth="120" />
            <controls:ColumnaTexto Header="Servicio" Binding="{Binding ServicioTexto}" Width="14*" MinWidth="100" />
            <controls:ColumnaNumero Header="Toneladas" Binding="{Binding ToneladasTexto}" Width="11*" MinWidth="76" />
            <controls:ColumnaNumero Header="Tarifa" Width="9*" MinWidth="72"
                                    Binding="{Binding TarifaMonto, StringFormat={}{0:N2}}" />
            <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="12*" MinWidth="88" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Cada remesa se factura por sus tres servicios (corte, alza y empuje, transporte), atribuidos al núcleo que los prestó. La tarifa queda copiada en la línea: reimprimir la factura no la cambia."
                   FontSize="{StaticResource FsCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
