<UserControl x:Class="ASO.Desktop.Views.CuentasPorCobrarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado con la ruta módulo · submódulo -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo" VerticalAlignment="Top"
              Padding="12,6" Cursor="Hand" Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <!-- Barra de herramientas: búsqueda, filtro por estado y acciones -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0" Grid.Column="0" Width="260" VerticalAlignment="Center"
                 Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Buscar por número de factura, cliente o finca" />

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <RadioButton Content="Todas" GroupName="FiltroFacturaCliente" IsChecked="True"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
          <RadioButton Content="Borrador" GroupName="FiltroFacturaCliente"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Borrador" />
          <RadioButton Content="Emitida" GroupName="FiltroFacturaCliente"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Emitida" />
          <RadioButton Content="Vencida" GroupName="FiltroFacturaCliente"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Vencida" />
          <RadioButton Content="Cobrada" GroupName="FiltroFacturaCliente"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Cobrada" />
          <RadioButton Content="Anulada" GroupName="FiltroFacturaCliente"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anulada" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                   Text="{Binding ResumenCartera}" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Generar factura" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                  Background="{StaticResource PrimaryBrush}" Foreground="White"
                  Command="{Binding GenerarCommand}" />
          <Button Content="Emitir" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding EmitirCommand}" />
          <Button Content="Registrar cobro" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding RegistrarCobroCommand}" />
          <Button Content="Anular" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding AnularCommand}" />
          <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding EliminarCommand}" />
          <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding ItemsView}"
                SelectedItem="{Binding SelectedItem}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Factura" Binding="{Binding NumeroTexto}" Width="90" />
          <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="250" />
          <DataGridTextColumn Header="Remesas" Binding="{Binding RemesasTexto}" Width="100" />
          <DataGridTextColumn Header="Toneladas" Width="100"
                              Binding="{Binding Toneladas, StringFormat={}{0:N2}}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Emisión" Binding="{Binding EmisionTexto}" Width="100" />
          <DataGridTextColumn Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="110" />
          <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="Estado" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ChipEstadoFacturaClienteStyle}">
                  <TextBlock Text="{Binding EstadoTexto}" FontSize="11" Foreground="White" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Detalle: las líneas de la factura seleccionada -->
    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0"
            Visibility="{Binding HayDetalle, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="Detalle de la factura"
                     Style="{StaticResource CardTitleStyle}" />
          <TextBlock Grid.Column="1" Text="{Binding TotalesTexto}" FontSize="12"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>

        <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="180" Margin="0,8,0,0"
                  ItemsSource="{Binding SelectedItem.Lineas}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Remesa" Binding="{Binding RemesaTexto}" Width="80" />
            <DataGridTextColumn Header="Finca" Binding="{Binding FincaNombre}" Width="180" />
            <DataGridTextColumn Header="Servicio" Binding="{Binding ServicioTexto}" Width="140" />
            <DataGridTextColumn Header="Toneladas" Binding="{Binding ToneladasTexto}" Width="110">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Tarifa" Width="90"
                                Binding="{Binding TarifaMonto, StringFormat={}{0:N2}}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Monto" Binding="{Binding MontoTexto}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Cada remesa se factura por sus tres servicios (corte, alza y empuje, transporte), atribuidos al núcleo que los prestó. La tarifa queda copiada en la línea: reimprimir la factura no la cambia."
                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
