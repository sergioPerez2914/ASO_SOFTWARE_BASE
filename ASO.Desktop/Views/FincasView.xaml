<UserControl x:Class="ASO.Desktop.Views.FincasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
          <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />
        </WrapPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,12,0,0">
          <Button Content="Nueva finca" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AgregarCommand}" />
          <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EditarCommand}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding EliminarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Código CAM" Binding="{Binding CodigoCam}" Width="14*" MinWidth="110" />
            <controls:ColumnaTexto Header="Nombre" Binding="{Binding Nombre}" Width="24*" MinWidth="140" />
            <controls:ColumnaTexto Header="Dueño" Binding="{Binding Dueno}" Width="20*" MinWidth="130" />
            <controls:ColumnaNumero Header="Hectáreas" Binding="{Binding HectareasTexto}" Width="12*" MinWidth="90" />
            <controls:ColumnaTexto Header="Lotes" Binding="{Binding Lotes.Count}" Width="9*" MinWidth="72" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.Fincas}"
                             Titulo="No hay fincas registradas"
                             Detalle="Una finca agrupa sus lotes y tablones; registra la primera."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
