<UserControl x:Class="ASO.Desktop.Views.FincasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:SearchBox Grid.Column="0" Width="280" VerticalAlignment="Center"
                              Sugerencia="Buscar por código CAM o nombre"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Nueva finca" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AgregarCommand}" />
          <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EditarCommand}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EliminarCommand}" />
          <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Código CAM" Binding="{Binding CodigoCam}" Width="140" />
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
            <DataGridTextColumn Header="Lotes" Binding="{Binding Lotes.Count}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xE707;"
                             Titulo="No hay fincas registradas"
                             Detalle="Una finca agrupa sus lotes y tablones; registra la primera."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
