<UserControl x:Class="ASO.Desktop.Views.HorariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Barra de herramientas: búsqueda, filtros y acciones -->
    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:SearchBox Grid.Row="0" Grid.Column="0" Width="280" VerticalAlignment="Center"
                              Sugerencia="Buscar por persona, cargo o núcleo"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <RadioButton Content="Todas" GroupName="FiltroJornada" IsChecked="True"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
          <RadioButton Content="Abiertas" GroupName="FiltroJornada"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Abiertas" />
          <RadioButton Content="Cerradas" GroupName="FiltroJornada"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Cerradas" />
          <RadioButton Content="Campo" GroupName="FiltroJornada"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Campo" />
          <RadioButton Content="Administrativos" GroupName="FiltroJornada"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Administrativos" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="{Binding ResumenHoras}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="·" FontSize="{StaticResource FsBody}" Margin="8,0"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding ResumenCambiosTurno}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Registrar entrada" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding RegistrarEntradaCommand}" />
          <Button Content="Registrar salida" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RegistrarSalidaCommand}" />
          <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Persona" Binding="{Binding PersonaNombre}" Width="200" />
            <DataGridTextColumn Header="Cargo / rol" Binding="{Binding CargoORol}" Width="150" />
            <DataGridTextColumn Header="Padrón" Binding="{Binding TipoPersonalTexto}" Width="120" />
            <DataGridTextColumn Header="Turno" Binding="{Binding TurnoTexto}" Width="90" />
            <DataGridTextColumn Header="Entrada" Binding="{Binding EntradaTexto}" Width="130" />
            <DataGridTextColumn Header="Salida" Binding="{Binding SalidaTexto}" Width="130" />
            <DataGridTextColumn Header="Horas" Binding="{Binding HorasTexto}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="Estado" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipJornadaStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xE787;"
                             Titulo="No hay jornadas registradas"
                             Detalle="Las jornadas se registran al marcar entrada y salida."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
