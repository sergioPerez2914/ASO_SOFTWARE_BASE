<UserControl x:Class="ASO.Desktop.Views.HorariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado con la ruta módulo · submódulo -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo" VerticalAlignment="Top"
              Padding="12,6" Cursor="Hand" Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <!-- Barra de herramientas: búsqueda, filtros y acciones -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0" Grid.Column="0" Width="260" VerticalAlignment="Center"
                 Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Buscar por persona, cargo o núcleo" />

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <RadioButton Content="Todas" GroupName="FiltroJornada" IsChecked="True"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
          <RadioButton Content="Abiertas" GroupName="FiltroJornada"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Abiertas" />
          <RadioButton Content="Cerradas" GroupName="FiltroJornada"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Cerradas" />
          <RadioButton Content="Campo" GroupName="FiltroJornada"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Campo" />
          <RadioButton Content="Administrativos" GroupName="FiltroJornada"
                       Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Administrativos" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="{Binding ResumenHoras}" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Text="·" FontSize="12" Margin="8,0"
                     Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="{Binding ResumenCambiosTurno}" FontSize="12"
                     Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Registrar entrada" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                  Background="{StaticResource PrimaryBrush}" Foreground="White"
                  Command="{Binding RegistrarEntradaCommand}" />
          <Button Content="Registrar salida" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding RegistrarSalidaCommand}" />
          <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                  Command="{Binding RefrescarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding ItemsView}"
                SelectedItem="{Binding SelectedItem}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
          <DataGridTextColumn Header="Persona" Binding="{Binding PersonaNombre}" Width="200" />
          <DataGridTextColumn Header="Cargo / rol" Binding="{Binding CargoORol}" Width="150" />
          <DataGridTextColumn Header="Padrón" Binding="{Binding TipoPersonalTexto}" Width="120" />
          <DataGridTextColumn Header="Turno" Binding="{Binding TurnoTexto}" Width="90" />
          <DataGridTextColumn Header="Entrada" Binding="{Binding EntradaTexto}" Width="130" />
          <DataGridTextColumn Header="Salida" Binding="{Binding SalidaTexto}" Width="130" />
          <DataGridTextColumn Header="Horas" Binding="{Binding HorasTexto}" Width="*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="Estado" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ChipJornadaStyle}">
                  <TextBlock Text="{Binding EstadoTexto}" FontSize="11" Foreground="White" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
