<UserControl x:Class="ASO.Desktop.Views.HorariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Conmutador de padrón: son dos catálogos distintos, no se mezclan. Mismo control y mismo
         motivo que en Nómina · Empleados, del que esta pantalla es la otra cara. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Administrativos" GroupName="PadronHorarios"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsAdministrativos, Mode=TwoWay}" />
      <RadioButton Content="Personal de campo" GroupName="PadronHorarios"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsCampo, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom"
            Background="{DynamicResource BorderBrush}" />

    <!-- Barra de herramientas, en tres bandas: qué frente se mira, cómo se acota lo que se ve,
         y qué se puede hacer. Antes las tres se pisaban en la misma fila. -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- El frente manda sobre las dos cosas: acota la tabla y es el que se estampa al fichar,
             así que va solo en la primera banda y no compitiendo con los filtros. -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    VerticalAlignment="Center" Margin="0,0,0,12"
                    Visibility="{Binding MostrarCampo, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Frente" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox Width="320" VerticalAlignment="Center"
                      Style="{StaticResource FormComboBoxStyle}"
                      ItemsSource="{Binding FrentesEnCurso}" DisplayMemberPath="Etiqueta"
                      SelectedItem="{Binding FrenteSeleccionado}"
                      ToolTip="Acota la tabla a ese frente y es el que se estampa en las entradas de campo" />
          </StackPanel>

          <!-- La ayuda va DEBAJO de su campo, como en cualquier formulario. Al lado del combo
               era una frase larga en la misma línea que las cifras de la derecha. -->
          <TextBlock Text="{Binding AyudaFrente}" Margin="{StaticResource TkAyuda}"
                     FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <!-- Tres cifras con su etiqueta, como los tres saldos de Banco. Antes eran dos frases
             pegadas con un punto medio, con dos cortes de tiempo distintos dentro.

             Van en la MISMA banda que los filtros, a la derecha. En su propia fila dejaban la
             mitad izquierda en blanco, y en la pestaña de administrativos —que no tiene frente—
             esa fila entera era un hueco vacío encima de la búsqueda. -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="16,0,0,0">
          <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Horas (14 días)" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding HorasQuincenaTexto}" FontWeight="SemiBold"
                       FontSize="{StaticResource FsSubtitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
          <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Jornadas abiertas" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding JornadasAbiertasTexto}" FontWeight="SemiBold"
                       FontSize="{StaticResource FsSubtitle}"
                       Foreground="{DynamicResource InfoTextBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Movimientos (7 días)" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding MovimientosSemanaTexto}" FontWeight="SemiBold"
                       FontSize="{StaticResource FsSubtitle}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- Búsqueda y filtro de estado. El grupo de chips es un StackPanel dentro del
             WrapPanel para que envuelva entero y no se parta por la mitad al estrechar.
             El padrón ya no está aquí: lo decide la pestaña de arriba. -->
        <WrapPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
          <controls:SearchBox Width="280" Margin="0,0,16,0" VerticalAlignment="Center"
                              Sugerencia="Buscar por persona, cargo, núcleo o remesa"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Estado" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <RadioButton Content="Todas" GroupName="FiltroJornadaEstado" IsChecked="True"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
            <RadioButton Content="Abiertas" GroupName="FiltroJornadaEstado"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Abiertas" />
            <RadioButton Content="Cerradas" GroupName="FiltroJornadaEstado"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Cerradas" />
          </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,12,0,0">
          <Button Content="Registrar entrada" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding RegistrarEntradaCommand}" />
          <Button Content="Registrar salida" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RegistrarSalidaCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Persona" Binding="{Binding PersonaNombre}" Width="20*" MinWidth="110" />
            <controls:ColumnaTexto Header="Cargo / rol" Binding="{Binding CargoORol}" Width="13*" MinWidth="90" />
            <controls:ColumnaTexto Header="Turno" Binding="{Binding TurnoTexto}" Width="9*" MinWidth="66" />
            <controls:ColumnaTexto Header="Remesa" Binding="{Binding RemesaTexto}" Width="9*" MinWidth="66" />
            <controls:ColumnaTexto Header="Entrada" Binding="{Binding EntradaTexto}" Width="13*" MinWidth="90" />
            <controls:ColumnaTexto Header="Salida" Binding="{Binding SalidaTexto}" Width="13*" MinWidth="90" />
            <controls:ColumnaNumero Header="Horas" Binding="{Binding HorasTexto}" Width="9*" MinWidth="64" />
            <DataGridTemplateColumn Header="Estado" Width="88">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipJornadaStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xE787;"
                             Titulo="No hay jornadas registradas"
                             Detalle="Las jornadas se registran al marcar entrada y salida."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
