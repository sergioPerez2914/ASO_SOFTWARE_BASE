<UserControl x:Class="ASO.Desktop.Views.AdministracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <Style x:Key="BarraBotonStyle" TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="Administración" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding NotaVigencia}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al inicio" VerticalAlignment="Top"
              Padding="12,6" Cursor="Hand" Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton Content="Núcleos" GroupName="AdminAcceso"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   IsChecked="{Binding PuedeVerOrganizaciones, Mode=OneTime}"
                   Visibility="{Binding PuedeVerOrganizaciones, Converter={StaticResource BoolToVis}}"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Organizaciones" />
      <RadioButton Content="Usuarios" GroupName="AdminAcceso"
                   IsChecked="{Binding MostrarUsuarios, Mode=OneTime}"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Usuarios" />
      <RadioButton Content="Ajustes de permisos" GroupName="AdminAcceso"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Permisos" />
    </StackPanel>

    <!-- Padron de nucleos (solo Desarrollador) -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarOrganizaciones, Converter={StaticResource BoolToVis}}"
          DataContext="{Binding Organizaciones}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" Width="260" VerticalAlignment="Center"
                   Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por código o nombre" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Nuevo núcleo" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="140" />
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>

    <!-- Padron de usuarios -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarUsuarios, Converter={StaticResource BoolToVis}}"
          DataContext="{Binding Usuarios}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" Width="260" VerticalAlignment="Center"
                   Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por usuario, nombre o rol" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Nuevo usuario" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="180" />
            <DataGridTextColumn Header="Nombre completo" Binding="{Binding NombreCompleto}" Width="*" />
            <DataGridTextColumn Header="Rol" Binding="{Binding RolTexto}" Width="200" />
            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>

    <!-- Ajustes de permisos -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarPermisos, Converter={StaticResource BoolToVis}}"
          DataContext="{Binding Permisos}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" Width="260" VerticalAlignment="Center"
                   Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por permiso o usuario" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Nuevo ajuste" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioNombre}" Width="180" />
            <DataGridTextColumn Header="Permiso" Binding="{Binding Permiso}" Width="*" />
            <DataGridTextColumn Header="Efecto" Binding="{Binding EfectoTexto}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
