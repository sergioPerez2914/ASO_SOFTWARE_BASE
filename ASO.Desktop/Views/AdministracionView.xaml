<UserControl x:Class="ASO.Desktop.Views.AdministracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Ruta}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="Administración" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        <TextBlock Text="Los usuarios del núcleo, con sus permisos, y los datos del propio núcleo."
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al inicio" VerticalAlignment="Top"
              Padding="12,6" Cursor="Hand" Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton Content="Usuarios" GroupName="AdminAcceso"
                   IsChecked="True"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Usuarios" />
      <RadioButton Content="Núcleo" GroupName="AdminAcceso"
                   Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Nucleo" />
    </StackPanel>

    <!-- Ficha del nucleo instalado: no es un padron, es la unica fila -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarNucleo, Converter={StaticResource BoolToVis}}">
      <Border DataContext="{Binding Nucleo}" Style="{StaticResource CardStyle}"
              VerticalAlignment="Top" HorizontalAlignment="Left" Width="460">
        <StackPanel>
          <TextBlock Text="Datos del núcleo" FontSize="15" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Una instalación atiende a un solo núcleo. El C.O.D es el que estampan las remesas, las liquidaciones y las facturas."
                     FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10" />

          <TextBlock Text="Nombre" Style="{StaticResource FormLabelStyle}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   IsEnabled="{Binding PuedeEditar}"
                   Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Código interno" Style="{StaticResource FormLabelStyle}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   IsEnabled="{Binding PuedeEditar}"
                   Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="C.O.D (código en el CAM)" Style="{StaticResource FormLabelStyle}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   IsEnabled="{Binding PuedeEditar}"
                   Text="{Binding CodigoCam, UpdateSourceTrigger=PropertyChanged}" />

          <Button Content="Guardar" Margin="0,16,0,0" HorizontalAlignment="Left"
                  Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                  Background="{StaticResource PrimaryBrush}" Foreground="White"
                  Command="{Binding GuardarCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Usuarios y sus permisos: maestro-detalle, se ve a quien se esta editando todo el tiempo -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarUsuarios, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Padron de usuarios -->
      <Grid Grid.Column="0" DataContext="{Binding Usuarios}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
          <StackPanel>
            <TextBox Style="{StaticResource FormTextBoxStyle}" Margin="0"
                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar por usuario, nombre o rol" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Nuevo" Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                      Background="{StaticResource PrimaryBrush}" Foreground="White"
                      Command="{Binding AgregarCommand}" />
              <Button Content="Editar" Style="{StaticResource BarraBotonStyle}"
                      Command="{Binding EditarCommand}" />
              <Button Content="Eliminar" Style="{StaticResource BarraBotonStyle}"
                      Command="{Binding EliminarCommand}" />
              <Button Content="Actualizar" Style="{StaticResource BarraBotonStyle}"
                      Command="{Binding RefrescarCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
          <DataGrid Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="*" />
              <DataGridTextColumn Header="Rol" Binding="{Binding RolTexto}" Width="140" />
              <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>

      <!-- Permisos del usuario seleccionado -->
      <Border Grid.Column="2" Style="{StaticResource CardStyle}"
              DataContext="{Binding PermisosDeUsuario}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Sin usuario seleccionado no hay nada que mostrar -->
          <TextBlock Grid.Row="0" Grid.RowSpan="3"
                     Text="Selecciona un usuario para ver y ajustar sus permisos."
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource TextMutedBrush}" FontSize="13">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HayUsuario}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel Grid.Row="0" Margin="0,0,0,10"
                      Visibility="{Binding HayUsuario, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Encabezado}" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Marcado = lo puede hacer. Lo que se aparta de su rol queda señalado como concedido o revocado."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding NotaBloqueo}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"
                       Visibility="{Binding HayBloqueo, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HayUsuario, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding FilasView}">
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Margin="0,12,0,4" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ItemsControl.GroupStyle>

              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,2,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Cursor="Hand"
                              Content="{Binding Etiqueta}"
                              IsChecked="{Binding Concedido}"
                              IsEnabled="{Binding Editable}"
                              Foreground="{StaticResource TextPrimaryBrush}">
                      <CheckBox.ToolTip>
                        <TextBlock>
                          <Run Text="{Binding Permiso, Mode=OneWay}" />
                          <LineBreak />
                          <Run Text="{Binding MotivoBloqueo, Mode=OneWay}" />
                        </TextBlock>
                      </CheckBox.ToolTip>
                    </CheckBox>

                    <TextBlock Grid.Column="1" Text="{Binding OrigenTexto}" FontSize="10"
                               VerticalAlignment="Center" Margin="8,0,4,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="0,12,0,0"
                      Visibility="{Binding HayUsuario, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding NotaVigencia}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
            <Button Content="Guardar permisos" HorizontalAlignment="Left"
                    Padding="14,7" Cursor="Hand" FontSize="12" BorderThickness="0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding GuardarCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
