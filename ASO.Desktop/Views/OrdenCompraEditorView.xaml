<UserControl x:Class="ASO.Desktop.Views.OrdenCompraEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="700">

  <StackPanel>
    <TextBlock Text="{Binding ResumenProveedor}" FontSize="12"
               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Complete el precio unitario de cada línea" Style="{StaticResource FormLabelStyle}" />
      <TextBlock Text="{Binding MontoCotizadoTexto, StringFormat='  ·  Cotizado en total: Bs {0}'}"
                 Style="{StaticResource FormLabelStyle}"
                 Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
    </StackPanel>

    <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="260"
              ItemsSource="{Binding Lineas}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns>
        <controls:ColumnaTexto Header="Tipo" Binding="{Binding TipoInsumoTexto}" Width="9*" MinWidth="90" IsReadOnly="True" />
        <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="20*" MinWidth="130" IsReadOnly="True" />
        <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="11*" MinWidth="90" IsReadOnly="True" />
        <DataGridTextColumn Header="Precio unitario" Width="11*" MinWidth="100"
                             Binding="{Binding PrecioUnitario, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="11*" MinWidth="90" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>

    <controls:FormField Etiqueta="Notas" >
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <TextBlock Text="El subtotal de cada línea no se actualiza en pantalla hasta guardar: se recalcula al reabrir el listado."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
