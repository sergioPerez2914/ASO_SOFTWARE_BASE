<UserControl x:Class="ASO.Desktop.Views.SeguimientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ASO.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <!-- Punto de la línea de tiempo: el color lo decide el tipo de evento -->
    <Style x:Key="PuntoTimelineStyle" TargetType="Border">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.InicioCarga}">
          <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.FinCarga}">
          <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.CambioTurno}">
          <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Mantenimiento}">
          <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Nota}">
          <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Confirmacion}">
          <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.LlegadaCentral}">
          <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Pesaje}">
          <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Anulacion}">
          <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Submodulo.Nombre}" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding Submodulo.Descripcion}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <Button Grid.Column="1" Content="Volver al módulo"
              Style="{StaticResource VolverModuloButtonStyle}"
              Command="{Binding VolverCommand}" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- MAESTRO: listado de remesas -->
      <Border Grid.Column="0" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBox Grid.Row="0" Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Buscar por Nº, finca o placa" />

          <Grid Grid.Row="1" Margin="0,10,0,10">
            <WrapPanel>
              <RadioButton Content="Todas" GroupName="FiltroSeguimiento" IsChecked="True"
                           Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,6"
                           Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
              <RadioButton Content="Borrador" GroupName="FiltroSeguimiento"
                           Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,6"
                           Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Borrador" />
              <RadioButton Content="Confirmada" GroupName="FiltroSeguimiento"
                           Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,6"
                           Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Confirmada" />
              <RadioButton Content="Recibida" GroupName="FiltroSeguimiento"
                           Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,6"
                           Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Recibida" />
              <RadioButton Content="Anulada" GroupName="FiltroSeguimiento"
                           Style="{StaticResource RangeToggleStyle}" Margin="0,0,6,6"
                           Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anulada" />
            </WrapPanel>
          </Grid>

          <ListBox Grid.Row="2" ItemsSource="{Binding RemesasView}"
                   SelectedItem="{Binding RemesaSeleccionada}"
                   BorderThickness="0" Background="Transparent"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis">
                      <Run Text="Nº" /><Run Text="{Binding Id, Mode=OneWay}" />
                      <Run Text=" · " /><Run Text="{Binding FincaNombre, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                      <Run Text="{Binding InicioCarga, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                      <Run Text=" · " /><Run Text="{Binding VehiculoPlaca, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>

                  <Border Grid.Column="1" Style="{StaticResource ChipEstadoStyle}"
                          VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- DETALLE: línea de tiempo -->
      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Encabezado del detalle -->
          <Grid Grid.Row="0" Margin="0,0,0,12"
                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" DataContext="{Binding RemesaSeleccionada}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center">
                  <Run Text="Remesa Nº" /><Run Text="{Binding Id, Mode=OneWay}" />
                </TextBlock>
                <Border Style="{StaticResource ChipEstadoStyle}" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding EstadoTexto}" FontSize="11" />
                </Border>
              </StackPanel>
              <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding FincaCodigoCam, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{Binding FincaNombre, Mode=OneWay}" />
                <Run Text=" — " /><Run Text="{Binding UbicacionTexto, Mode=OneWay}" />
                <Run Text=" — Placa " /><Run Text="{Binding VehiculoPlaca, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Content="Agregar nota" Padding="14,7" Cursor="Hand" FontSize="12"
                      BorderThickness="0" Background="{DynamicResource PrimaryBrush}" Foreground="White"
                      Command="{Binding AgregarNotaCommand}" />
              <Button Content="Actualizar" Padding="12,6" Margin="8,0,0,0" Cursor="Hand" FontSize="12"
                      Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Command="{Binding RefrescarCommand}" />
            </StackPanel>
          </Grid>

          <!-- Sin selección -->
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HaySeleccion}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xEADF;" Style="{StaticResource NavIconStyle}" FontSize="40"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Seleccione una remesa para ver su línea de tiempo."
                       FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>

          <!-- Línea de tiempo -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Eventos}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Riel: tramo superior, punto, tramo inferior.
                         Hidden (no Collapsed) para que la fila conserve su alto. -->
                    <Grid Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>

                      <Border Grid.Row="0" Width="2" HorizontalAlignment="Center"
                              Background="{DynamicResource BorderBrush}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EsPrimero}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>

                      <Border Grid.Row="1" Style="{StaticResource PuntoTimelineStyle}">
                        <TextBlock Text="{Binding Evento.Glifo}" Style="{StaticResource NavIconStyle}"
                                   FontSize="12" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <Border Grid.Row="2" Width="2" HorizontalAlignment="Center"
                              Background="{DynamicResource BorderBrush}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EsUltimo}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,6,0,18">
                      <TextBlock Text="{Binding Evento.FechaHoraTexto}" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Text="{Binding Evento.EtiquetaTipo}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="{Binding Evento.Descripcion}" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                      <TextBlock FontSize="11" Margin="0,4,0,0"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 Visibility="{Binding TieneAutor, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Evento.Autor, StringFormat=Registrado por {0}}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
