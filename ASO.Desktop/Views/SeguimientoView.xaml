<UserControl x:Class="ASO.Desktop.Views.SeguimientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             xmlns:models="clr-namespace:ASO.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <!-- Punto de la línea de tiempo: el color lo decide el tipo de evento.
         Radio de tarjeta (RadMd), no un círculo: mismo lenguaje visual que el resto
         de la aplicación (tarjetas, chips cuadrados), no un badge redondo suelto. -->
    <Style x:Key="PuntoTimelineStyle" TargetType="Border">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="{StaticResource RadMd}" />
      <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.InicioCarga}">
          <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.FinCarga}">
          <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.CambioTurno}">
          <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Mantenimiento}">
          <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Nota}">
          <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Confirmacion}">
          <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.LlegadaCentral}">
          <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Pesaje}">
          <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Anulacion}">
          <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Facturacion}">
          <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Cobro}">
          <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Liquidacion}">
          <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Edicion}">
          <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Evento.Tipo}" Value="{x:Static models:TipoEventoOperacion.Peticion}">
          <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Fila pulsable de la linea de tiempo. Hereda de la tarjeta pulsable del proyecto por el
         cursor y la realimentacion de hover, pero le quita el marco: aqui el nodo y el riel ya
         delimitan la fila, y un borde por evento convertiria la columna en una lista de cajas. -->
    <Style x:Key="FilaEventoStyle" TargetType="Button" BasedOn="{StaticResource CardButtonStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,6,8,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Resources>

  <!-- Alto explícito, tomado del ScrollViewer del shell: sin él, un Grid con fila "*" dentro de un
       ScrollViewer recibe alto infinito y sus filas "*" se comportan como Auto (todo su contenido
       se mide de una vez). Eso hacía que el maestro y la línea de tiempo nunca activaran su propio
       ScrollViewer interno y el módulo entero se desplazara como una sola pieza en vez de que el
       scroll quedara dentro de la card de la operación. -->
  <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- MAESTRO: listado de remesas. Sin Border envolvente: solo aportaba un relleno
           inferior que ya pone la barra de parametros de dentro. -->
      <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Barra de parametros. Aqui la lista es un ListBox en una columna estrecha, asi que
               el buscador y las pastillas caen en la misma columna y el recuadro las agrupa
               igual que en el resto de modulos. -->
          <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
            <WrapPanel VerticalAlignment="Center">
              <controls:SearchBox Width="280" Margin="0,0,12,8" VerticalAlignment="Center"
                                  Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

              <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                       Margin="0,0,12,8" VerticalAlignment="Center"
                                       Command="{Binding CambiarFiltroEstadoCommand}">
                <ComboBoxItem Content="Todas" />
                <ComboBoxItem Content="Borrador" />
                <ComboBoxItem Content="Confirmada" />
                <ComboBoxItem Content="Recibida" />
                <ComboBoxItem Content="Anulada" />
              </controls:FiltroDropdown>
            </WrapPanel>
          </Border>

          <ListBox Grid.Row="1" ItemsSource="{Binding RemesasView}"
                   SelectedItem="{Binding RemesaSeleccionada}"
                   BorderThickness="0" Background="Transparent"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="{StaticResource FsSubtitle}" FontWeight="{StaticResource FwMedium}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis">
                      <Run Text="Nº" /><Run Text="{Binding Id, Mode=OneWay}" />
                      <Run Text=" · " /><Run Text="{Binding FincaNombre, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="{StaticResource FsCaption}" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                      <Run Text="{Binding InicioCarga, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                      <Run Text=" · " /><Run Text="{Binding VehiculoPlaca, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>

                  <Border Grid.Column="1" Style="{StaticResource ChipEstadoStyle}"
                          VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

      <!-- DETALLE: línea de tiempo -->
      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Encabezado del detalle -->
          <Grid Grid.Row="0" Margin="0,0,0,12"
                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" DataContext="{Binding RemesaSeleccionada}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center">
                  <Run Text="Remesa Nº" /><Run Text="{Binding Id, Mode=OneWay}" />
                </TextBlock>
                <Border Style="{StaticResource ChipEstadoStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                </Border>
              </StackPanel>
              <TextBlock FontSize="{StaticResource FsBody}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding FincaCodigoCam, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{Binding FincaNombre, Mode=OneWay}" />
                <Run Text=" — " /><Run Text="{Binding UbicacionTexto, Mode=OneWay}" />
                <Run Text=" — Placa " /><Run Text="{Binding VehiculoPlaca, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Content="Agregar nota" Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding AgregarNotaCommand}" />
            </StackPanel>
          </Grid>

          <!-- Sin selección -->
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HaySeleccion}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="{x:Static controls:Iconos.Seguimiento}" Style="{StaticResource NavIconStyle}" FontSize="{StaticResource FsHero}"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Seleccione una remesa para ver su línea de tiempo."
                       FontSize="{StaticResource FsBody}" Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>

          <!-- Línea de tiempo -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Eventos}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Riel: tramo superior, punto, tramo inferior.
                         Hidden (no Collapsed) para que la fila conserve su alto. -->
                    <Grid Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>

                      <Border Grid.Row="0" Width="2" HorizontalAlignment="Center"
                              Background="{DynamicResource BorderBrush}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EsPrimero}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>

                      <Border Grid.Row="1" Style="{StaticResource PuntoTimelineStyle}">
                        <TextBlock Text="{Binding Evento.Glifo}" Style="{StaticResource NavIconStyle}"
                                   FontSize="{StaticResource FsBody}"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <Border Grid.Row="2" Width="2" HorizontalAlignment="Center"
                              Background="{DynamicResource BorderBrush}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EsUltimo}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </Grid>

                    <Button Grid.Column="1" Style="{StaticResource FilaEventoStyle}"
                            Command="{Binding DataContext.VerDetalleEventoCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Ver la ficha completa de este evento"
                            AutomationProperties.Name="{Binding Evento.EtiquetaTipo}">
                      <StackPanel>
                        <TextBlock Text="{Binding Evento.FechaHoraTexto}" FontSize="{StaticResource FsCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Evento.EtiquetaTipo}" FontSize="{StaticResource FsSubtitle}" FontWeight="{StaticResource FwMedium}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Evento.Descripcion}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock FontSize="{StaticResource FsCaption}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding TieneAutor, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding Evento.Autor, StringFormat=Registrado por {0}}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
