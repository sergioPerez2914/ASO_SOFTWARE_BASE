<UserControl x:Class="ASO.Desktop.Views.ConfirmarRecepcionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="420">

  <StackPanel>
    <TextBlock Text="{Binding ResumenProveedor}" FontSize="{StaticResource FsBody}"
               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

    <controls:FormField Etiqueta="Notas">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <StackPanel Visibility="{Binding HayLineasRepuesto, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
      <TextBlock Text="Ubicación de los repuestos recibidos" Style="{StaticResource FormLabelStyle}" />
      <ItemsControl ItemsSource="{Binding LineasRepuesto}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding ArticuloNombre}" VerticalAlignment="Center"
                         TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="2" Style="{StaticResource FormTextBoxStyle}"
                       Text="{Binding UbicacionArticulo, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Text="{Binding AvisoSinEmpleados}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
               Margin="0,12,0,0"
               Foreground="{DynamicResource DangerTextBrush}"
               Visibility="{Binding NoHayEmpleados, Converter={StaticResource BoolToVis}}" />

    <StackPanel Visibility="{Binding HayEmpleados, Converter={StaticResource BoolToVis}}">
      <controls:FormField Etiqueta="Recibido por" Margin="0,12,0,0">
        <ListBox MaxHeight="160" BorderThickness="1"
                 ItemsSource="{Binding Empleados}"
                 DisplayMemberPath="Nombre"
                 SelectedItem="{Binding ResponsableSeleccionado}" />
      </controls:FormField>
    </StackPanel>

    <TextBlock Text="Al confirmar se suma cada línea al stock que le corresponde por lo realmente recibido, no por lo pedido. Si hace falta corregir una cantidad o una presentación, use &quot;Editar&quot; antes de confirmar."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
