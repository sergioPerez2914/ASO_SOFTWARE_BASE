<UserControl x:Class="ASO.Desktop.Views.MantenimientoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="520">

  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0">
        <TextBlock Text="Activo" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Activos}" DisplayMemberPath="Etiqueta"
                  SelectedItem="{Binding ActivoSeleccionado}" />
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="2">
        <TextBlock Text="Tipo de trabajo" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Tipos}"
                  SelectedItem="{Binding TipoSeleccionado}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock Text="Fecha y hora del trabajo" Style="{StaticResource FormLabelStyle}" />
        <StackPanel Orientation="Horizontal">
          <DatePicker Style="{StaticResource FormDatePickerStyle}" Width="140"
                      SelectedDate="{Binding Fecha}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}" Width="64" Margin="8,0,0,0"
                   Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Hora en formato HH:mm" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2">
        <TextBlock Text="{Binding EtiquetaLectura}" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding LecturaTexto, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Lectura del instrumento al momento del trabajo (opcional)" />
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="0">
        <TextBlock Text="Costo de repuestos" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding CostoRepuestosTexto, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="2">
        <TextBlock Text="Costo de mano de obra" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding CostoManoObraTexto, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Descripción del trabajo" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="Repuestos usados" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Text="{Binding RepuestosUsados, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Un repuesto por línea. Se descontará de Inventario cuando exista el módulo." />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Realizado por" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding RealizadoPor, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Se vinculará al padrón de Nómina cuando exista el módulo" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Remesa vinculada (opcional)" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding RemesasVinculables}" DisplayMemberPath="Etiqueta"
                  SelectedItem="{Binding OpcionRemesaSeleccionada}"
                  ToolTip="El trabajo aparecerá en la línea de tiempo de esa remesa" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
