<UserControl x:Class="ASO.Desktop.Views.MantenimientoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="520">

  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0">
        <controls:FormField Etiqueta="Activo">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Activos}" DisplayMemberPath="Etiqueta"
                    SelectedItem="{Binding ActivoSeleccionado}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="2">
        <controls:FormField Etiqueta="Tipo de trabajo">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Tipos}"
                    SelectedItem="{Binding TipoSeleccionado}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock Text="Fecha y hora del trabajo" Style="{StaticResource FormLabelStyle}" />
        <StackPanel Orientation="Horizontal">
          <DatePicker Style="{StaticResource FormDatePickerStyle}" Width="140"
                      SelectedDate="{Binding Fecha}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}" Width="64" Margin="8,0,0,0"
                   Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Hora en formato HH:mm" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2">
        <controls:FormField Etiqueta="{Binding EtiquetaLectura}">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding LecturaTexto, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Lectura del instrumento al momento del trabajo (opcional)" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="0">
        <controls:FormField Etiqueta="Costo de repuestos">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding CostoRepuestosTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="2">
        <controls:FormField Etiqueta="Costo de mano de obra">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding CostoManoObraTexto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Descripción del trabajo">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Repuestos usados">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding RepuestosUsados, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Un repuesto por línea. Se descontará de Inventario cuando exista el módulo." />
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Realizado por">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding RealizadoPor, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Se vinculará al padrón de Nómina cuando exista el módulo" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Remesa vinculada (opcional)">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding RemesasVinculables}" DisplayMemberPath="Etiqueta"
                    SelectedItem="{Binding OpcionRemesaSeleccionada}"
                    ToolTip="El trabajo aparecerá en la línea de tiempo de esa remesa" />
        </controls:FormField>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
