<UserControl x:Class="ASO.Desktop.Views.UsuarioEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <TextBlock Text="Nombre de usuario" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="Nombre completo" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="Rol" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding RolesDisponibles}"
              SelectedItem="{Binding RolSeleccionado}"
              DisplayMemberPath="Texto" />

    <TextBlock Text="{Binding EtiquetaPassword}" Style="{StaticResource FormLabelStyle}" />
    <PasswordBox x:Name="PasswordBox" Padding="8,6" PasswordChanged="OnPasswordChanged" />

    <CheckBox Content="Activo" Margin="0,14,0,0" Cursor="Hand"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="El usuario queda en el núcleo activo y solo verá los datos de ese núcleo. La contraseña se guarda cifrada; no se puede consultar después, solo reemplazar."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
  </StackPanel>
</UserControl>
