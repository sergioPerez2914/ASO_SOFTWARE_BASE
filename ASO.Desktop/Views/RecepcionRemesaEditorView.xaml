<UserControl x:Class="ASO.Desktop.Views.RecepcionRemesaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <TextBlock Text="{Binding ResumenRemesa}" FontSize="12" TextWrapping="Wrap"
               Foreground="{StaticResource TextSecondaryBrush}" />
    <TextBlock Text="{Binding FinCargaTexto}" FontSize="11" Margin="0,4,0,0"
               Foreground="{StaticResource TextMutedBrush}" />

    <TextBlock Text="Llegada al central (fecha y hora)" Style="{StaticResource FormLabelStyle}" />
    <StackPanel Orientation="Horizontal">
      <DatePicker Style="{StaticResource FormDatePickerStyle}" Width="150"
                  SelectedDate="{Binding LlegadaFecha}" />
      <TextBox Style="{StaticResource FormTextBoxStyle}" Width="70" Margin="8,0,0,0"
               Text="{Binding LlegadaHora, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Hora en formato HH:mm" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Peso bruto (t)" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding PesoBrutoTexto, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Tara (t)" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding TaraTexto, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource AlertBoxStyle}" Margin="0,16,0,0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Peso neto (t):" FontSize="12" VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding PesoNetoTexto}" Style="{StaticResource FormValorCalculadoStyle}"
                   Margin="8,0,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
