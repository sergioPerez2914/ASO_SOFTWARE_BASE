<UserControl x:Class="ASO.Desktop.Views.LiquidacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Barra de herramientas: búsqueda, filtro por estado y acciones -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
          <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                              Sugerencia="Buscar por núcleo o empleado"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <RadioButton Content="Todas" GroupName="FiltroLiquidacion" IsChecked="True"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
          <RadioButton Content="Borrador" GroupName="FiltroLiquidacion"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Borrador" />
          <RadioButton Content="Cerrada" GroupName="FiltroLiquidacion"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Cerrada" />
          <RadioButton Content="Pagada" GroupName="FiltroLiquidacion"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Pagada" />
          <RadioButton Content="Anulada" GroupName="FiltroLiquidacion"
                       Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                       Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anulada" />
        </WrapPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,12,0,0">
          <Button Content="Generar liquidación" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding GenerarCommand}" />
          <Button Content="Agregar concepto" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding AgregarConceptoCommand}" />
          <Button Content="Quitar línea" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding QuitarLineaCommand}" />
          <Button Content="Cerrar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding CerrarCommand}" />
          <Button Content="Registrar pago" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding PagarCommand}" />
          <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding AnularCommand}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding EliminarCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Tipo" Binding="{Binding SujetoTipoTexto}" Width="9*" MinWidth="72" />
            <controls:ColumnaTexto Header="Sujeto" Binding="{Binding SujetoTexto}" Width="24*" MinWidth="140" />
            <controls:ColumnaTexto Header="Período" Binding="{Binding PeriodoTexto}" Width="18*" MinWidth="110" />
            <controls:ColumnaNumero Header="Devengos" Width="11*" MinWidth="84"
                                    Binding="{Binding TotalDevengos, StringFormat={}{0:N2}}" />
            <controls:ColumnaNumero Header="Deducciones" Width="11*" MinWidth="90"
                                    Binding="{Binding TotalDeducciones, StringFormat={}{0:N2}}" />
            <controls:ColumnaNumero Header="Neto" Binding="{Binding NetoTexto}" Width="12*" MinWidth="88">
              <controls:ColumnaNumero.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
              </controls:ColumnaNumero.ElementStyle>
            </controls:ColumnaNumero>
            <DataGridTemplateColumn Header="Estado" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipEstadoLiquidacionStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="&#xE9F9;"
                             Titulo="No hay liquidaciones"
                             Detalle="Se generan a partir de las remesas y jornadas del período."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>

    <!-- Detalle: las líneas de la liquidación seleccionada -->
    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0"
            Visibility="{Binding HayDetalle, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="Detalle de la liquidación"
                     Style="{StaticResource CardTitleStyle}" />
          <TextBlock Grid.Column="1" Text="{Binding TotalesTexto}" FontSize="{StaticResource FsBody}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <DataGrid Style="{StaticResource DataGridStyle}" MaxHeight="180" Margin="0,8,0,0"
                  ItemsSource="{Binding SelectedItem.Lineas}"
                  SelectedItem="{Binding LineaSeleccionada}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Concepto" Binding="{Binding Concepto}" Width="26*" MinWidth="150" />
            <controls:ColumnaTexto Header="Origen" Binding="{Binding OrigenTexto}" Width="11*" MinWidth="84" />
            <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="13*" MinWidth="90" />
            <controls:ColumnaNumero Header="Tarifa" Binding="{Binding TarifaTexto}" Width="10*" MinWidth="76" />
            <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="12*" MinWidth="88" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Las líneas de destajo y de horas se calculan desde las remesas y las jornadas: para corregirlas hay que corregir el documento de origen."
                   FontSize="{StaticResource FsCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
