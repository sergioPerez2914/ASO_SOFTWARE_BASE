<UserControl x:Class="ASO.Desktop.Views.CuentasPorPagarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Conmutador: las deudas y el maestro de quienes las emiten -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton Content="Facturas por pagar" GroupName="VistaCxP" IsChecked="True"
                   Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Facturas" />
      <RadioButton Content="Proveedores" GroupName="VistaCxP"
                   Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                   Command="{Binding CambiarVistaCommand}" CommandParameter="Proveedores" />
    </StackPanel>

    <!-- Facturas de compra -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}">
      <!-- DataContext en un Grid interno: compartir elemento con Visibility haría que esa
           binding se resuelva contra el sub-VM (sin MostrarFacturas) y no contra este ViewModel. -->
      <Grid DataContext="{Binding Facturas}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <controls:SearchBox Grid.Row="0" Grid.Column="0" Width="280" VerticalAlignment="Center"
                              Sugerencia="Buscar por proveedor, número o descripción"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <RadioButton Content="Todas" GroupName="FiltroCxP" IsChecked="True"
                         Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
            <RadioButton Content="Pendientes" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Pendientes" />
            <RadioButton Content="Vencidas" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Vencidas" />
            <RadioButton Content="Pagadas" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Pagadas" />
            <RadioButton Content="Anuladas" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anuladas" />
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                     Text="{Binding ResumenDeuda}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Registrar factura" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Registrar pago" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RegistrarPagoCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding AnularCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla1" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Documento" Binding="{Binding NumeroDocumento}" Width="110" />
              <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="240" />
              <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
              <DataGridTextColumn Header="Emisión" Width="100"
                                  Binding="{Binding FechaEmision, StringFormat={}{0:dd/MM/yyyy}}" />
              <DataGridTextColumn Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="110" />
              <DataGridTextColumn Header="Plazo" Binding="{Binding PlazoTexto}" Width="160" />
              <DataGridTextColumn Header="Monto" Binding="{Binding MontoTexto}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="Estado" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoFacturaProveedorStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xEB0F;"
                               Titulo="No hay facturas de proveedor"
                               Detalle="Registra la primera factura para empezar a controlar la deuda."
                               Visibility="{Binding HasItems, ElementName=Tabla1, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- Maestro de proveedores -->
    <Grid Grid.Row="2" Visibility="{Binding MostrarProveedores, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding Proveedores}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <controls:SearchBox Grid.Column="0" Width="280" VerticalAlignment="Center"
                              Sugerencia="Buscar por nombre, RIF o teléfono"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Nuevo proveedor" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EliminarCommand}" />
            <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefrescarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla2" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" />
              <DataGridTextColumn Header="Proveedor" Binding="{Binding Nombre}" Width="260" />
              <DataGridTextColumn Header="RIF" Binding="{Binding Rif}" Width="140" />
              <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="140" />
              <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" Width="*" />
              <DataGridTemplateColumn Header="Estado" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipActivoStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xE716;"
                               Titulo="No hay proveedores"
                               Detalle="Da de alta un proveedor antes de registrar sus facturas."
                               Visibility="{Binding HasItems, ElementName=Tabla2, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
