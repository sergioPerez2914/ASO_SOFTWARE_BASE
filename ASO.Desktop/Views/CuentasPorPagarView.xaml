<UserControl x:Class="ASO.Desktop.Views.CuentasPorPagarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Conmutador: las deudas y el maestro de quienes las emiten.

         Pestanas y no pastillas: las pastillas son el estilo de los FILTROS de la barra de
         abajo, y usarlas tambien aqui dibujaba igual "que miro" y "como lo acoto". -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Facturas por pagar" GroupName="VistaCxP"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsFacturas, Mode=TwoWay}" />
      <RadioButton Content="Proveedores" GroupName="VistaCxP"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsProveedores, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom"
            Background="{DynamicResource BorderBrush}" />

    <!-- Facturas de compra -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarFacturas, Converter={StaticResource BoolToVis}}">
      <!-- DataContext en un Grid interno: compartir elemento con Visibility haría que esa
           binding se resuelva contra el sub-VM (sin MostrarFacturas) y no contra este ViewModel. -->
      <Grid DataContext="{Binding Facturas}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Sugerencia="Buscar por proveedor, número o descripción"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <RadioButton Content="Todas" GroupName="FiltroCxP" IsChecked="True"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todas" />
            <RadioButton Content="Pendientes" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Pendientes" />
            <RadioButton Content="Vencidas" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Vencidas" />
            <RadioButton Content="Pagadas" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Pagadas" />
            <RadioButton Content="Anuladas" GroupName="FiltroCxP"
                         Style="{StaticResource FilterChipStyle}"
                         Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Anuladas" />
          </WrapPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding ResumenDeuda}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Registrar factura" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Registrar pago" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RegistrarPagoCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla1" Style="{StaticResource DataGridStyle}" MaxHeight="480"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Documento" Binding="{Binding NumeroDocumento}" Width="11*" MinWidth="78" />
              <controls:ColumnaTexto Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="24*" MinWidth="120" />
              <controls:ColumnaTexto Header="Descripción" Binding="{Binding Descripcion}" Width="20*" MinWidth="100" />
              <controls:ColumnaTexto Header="Emisión" Width="10*" MinWidth="78"
                                     Binding="{Binding FechaEmision, StringFormat={}{0:dd/MM/yyyy}}" />
              <controls:ColumnaTexto Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="11*" MinWidth="78" />
              <controls:ColumnaTexto Header="Plazo" Binding="{Binding PlazoTexto}" Width="16*" MinWidth="90" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="11*" MinWidth="80">
                <controls:ColumnaNumero.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </Style>
                </controls:ColumnaNumero.ElementStyle>
              </controls:ColumnaNumero>
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoFacturaProveedorStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xEB0F;"
                               Titulo="No hay facturas de proveedor"
                               Detalle="Registra la primera factura para empezar a controlar la deuda."
                               Visibility="{Binding HasItems, ElementName=Tabla1, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- Maestro de proveedores -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarProveedores, Converter={StaticResource BoolToVis}}">
      <Grid DataContext="{Binding Proveedores}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Sugerencia="Buscar por nombre, RIF o teléfono"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />
          </WrapPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Nuevo proveedor" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla2" Style="{StaticResource DataGridStyle}" MaxHeight="480"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
              <controls:ColumnaTexto Header="Proveedor" Binding="{Binding Nombre}" Width="26*" MinWidth="140" />
              <controls:ColumnaTexto Header="RIF" Binding="{Binding Rif}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Teléfono" Binding="{Binding Telefono}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Notas" Binding="{Binding Notas}" Width="20*" MinWidth="110" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipActivoStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="&#xE716;"
                               Titulo="No hay proveedores"
                               Detalle="Da de alta un proveedor antes de registrar sus facturas."
                               Visibility="{Binding HasItems, ElementName=Tabla2, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
