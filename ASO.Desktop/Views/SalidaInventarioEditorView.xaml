<UserControl x:Class="ASO.Desktop.Views.SalidaInventarioEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="480">

  <StackPanel>
    <TextBlock Text="Artículo" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding Articulos}"
              SelectedItem="{Binding ArticuloSeleccionado}">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock>
            <Run Text="{Binding Nombre, Mode=OneWay}" />
            <Run Text=" — quedan " Foreground="{StaticResource TextMutedBrush}" />
            <Run Text="{Binding StockTexto, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
          </TextBlock>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock Text="{Binding ExistenciaTexto}" FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Cantidad" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Fecha" Style="{StaticResource FormLabelStyle}" />
        <DatePicker Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding Fecha}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Activo al que se carga (opcional)" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding Activos}"
              DisplayMemberPath="Etiqueta"
              SelectedItem="{Binding ActivoSeleccionado}" />

    <TextBlock Text="Mantenimiento al que se imputa (opcional)" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding Mantenimientos}"
              SelectedItem="{Binding MantenimientoSeleccionado}">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock>
            <Run Text="Nº " />
            <Run Text="{Binding Id, Mode=OneWay}" />
            <Run Text=" · " Foreground="{StaticResource TextMutedBrush}" />
            <Run Text="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}, Mode=OneWay}" />
            <Run Text=" · " Foreground="{StaticResource TextMutedBrush}" />
            <Run Text="{Binding Descripcion, Mode=OneWay}" />
          </TextBlock>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock Text="Al confirmar la salida, su costo se suma al del mantenimiento elegido. Elija primero el activo para ver sus mantenimientos."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />

    <TextBlock Text="Motivo" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" />
  </StackPanel>
</UserControl>
