<UserControl x:Class="ASO.Desktop.Views.JornadaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420">

  <StackPanel>
    <TextBlock Text="Padrón" Style="{StaticResource FormLabelStyle}" />
    <StackPanel Orientation="Horizontal">
      <RadioButton Content="Administrativo" GroupName="PadronJornada" Margin="0,0,6,0"
                   Style="{StaticResource RangeToggleStyle}"
                   IsChecked="{Binding EsAdministrativo, Mode=OneWay}"
                   Command="{Binding CambiarPadronCommand}" CommandParameter="Administrativo" />
      <RadioButton Content="Personal de campo" GroupName="PadronJornada"
                   Style="{StaticResource RangeToggleStyle}"
                   IsChecked="{Binding EsCampo, Mode=OneWay}"
                   Command="{Binding CambiarPadronCommand}" CommandParameter="Campo" />
    </StackPanel>

    <TextBlock Text="Persona" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding Personas}"
              DisplayMemberPath="Nombre"
              SelectedItem="{Binding PersonaSeleccionada}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Fecha" Style="{StaticResource FormLabelStyle}" />
        <DatePicker Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding Fecha}" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Hora de entrada" Style="{StaticResource FormLabelStyle}" />
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding HoraEntrada, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Formato HH:mm" />
      </StackPanel>

      <StackPanel Grid.Column="4">
        <TextBlock Text="Turno" Style="{StaticResource FormLabelStyle}" />
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Turnos}" SelectedItem="{Binding Turno}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Observación" Style="{StaticResource FormLabelStyle}" />
    <TextBox Style="{StaticResource FormTextBoxStyle}"
             AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Text="La jornada queda abierta hasta que se registre la salida. Una persona no puede tener dos jornadas abiertas a la vez."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
