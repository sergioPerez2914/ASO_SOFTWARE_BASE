<UserControl x:Class="ASO.Desktop.Views.JornadaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="420">

  <StackPanel>
    <!-- El padrón llega decidido de la pestaña de la pantalla; aquí solo se enseña, igual que
         el frente, para que se vea de dónde sale la lista de personas. -->
    <StackPanel Margin="0,0,0,8">
      <TextBlock Text="Padrón" Style="{StaticResource FormLabelStyle}" />
      <TextBlock Text="{Binding PadronTexto}" TextWrapping="Wrap"
                 FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </StackPanel>

    <controls:FormField Etiqueta="Persona">
      <ComboBox Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding Personas}"
                DisplayMemberPath="Nombre"
                SelectedItem="{Binding PersonaSeleccionada}" />
    </controls:FormField>

    <StackPanel Visibility="{Binding EsCampo, Converter={StaticResource BoolToVis}}"
                Margin="0,4,0,8">
      <TextBlock Text="Frente de trabajo" Style="{StaticResource FormLabelStyle}" />
      <TextBlock Text="{Binding FrenteTexto}" TextWrapping="Wrap"
                 FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Fecha">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Fecha}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Hora de entrada">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding HoraEntrada, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Formato HH:mm" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="4">
        <controls:FormField Etiqueta="Turno">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Turnos}" SelectedItem="{Binding Turno}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Observación">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <TextBlock Text="La jornada queda abierta hasta que se registre la salida. Una persona no puede tener dos jornadas abiertas a la vez. En campo, la entrada y la salida quedan registradas en el seguimiento del frente; para cambiar de frente, ciérrelo arriba antes de registrar."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
