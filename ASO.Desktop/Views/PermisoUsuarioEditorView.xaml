<UserControl x:Class="ASO.Desktop.Views.PermisoUsuarioEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420">

  <StackPanel>
    <TextBlock Text="Usuario" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}"
              ItemsSource="{Binding Usuarios}"
              SelectedItem="{Binding Usuario}"
              DisplayMemberPath="NombreUsuario" />

    <TextBlock Text="Permiso" Style="{StaticResource FormLabelStyle}" />
    <ComboBox Style="{StaticResource FormComboBoxStyle}" IsEditable="False"
              ItemsSource="{Binding Permisos}"
              SelectedItem="{Binding Permiso}"
              MaxDropDownHeight="260" />

    <CheckBox Content="Conceder (desmarcar para revocar)" Margin="0,14,0,0" Cursor="Hand"
              IsChecked="{Binding Concedido}" />

    <TextBlock Text="El ajuste se suma a lo que ya trae el rol. Revocar gana sobre conceder, y sobre lo que el rol otorgue por defecto."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
  </StackPanel>
</UserControl>
