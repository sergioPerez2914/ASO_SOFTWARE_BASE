<UserControl x:Class="ASO.Desktop.Views.RepuestosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Conmutador: el catálogo del almacén y el documento que lo mueve.

         Pestañas y no pastillas: las pastillas son el estilo de los FILTROS, y usarlas también
         aquí hacía que "qué estoy mirando" y "cómo lo acoto" se dibujaran igual. Enlazado en dos
         vías, porque VistaActual cambia también desde el código —al registrar una salida la
         pantalla salta sola a Salidas— y con Command la pestaña se quedaba marcada en la otra. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Existencias" GroupName="VistaInventario"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsExistencias, Mode=TwoWay}" />
      <RadioButton Content="Salidas de almacén" GroupName="VistaInventario"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsSalidas, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource TabStripStyle}" VerticalAlignment="Bottom" />

    <!-- Existencias del almacén -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarExistencias, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroStockCommand}">
              <ComboBoxItem Content="Todos" />
              <ComboBoxItem Content="Disponible" />
              <ComboBoxItem Content="Stock bajo" Tag="Bajo" />
              <ComboBoxItem Content="Agotado" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResumenExistencias}"
                     FontSize="{StaticResource FsBody}" VerticalAlignment="Center"
                     Margin="12,0,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Nuevo artículo" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Registrar salida" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RegistrarSalidaCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla1" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Código" Binding="{Binding Codigo}" Width="9*" MinWidth="76" />
              <controls:ColumnaTexto Header="Artículo" Binding="{Binding Nombre}" Width="24*" MinWidth="130" />
              <controls:ColumnaTexto Header="Categoría" Binding="{Binding Categoria}" Width="16*" MinWidth="94" />
              <controls:ColumnaTexto Header="Ubicación" Binding="{Binding Ubicacion}" Width="11*" MinWidth="84" />
              <controls:ColumnaNumero Header="Existencia" Binding="{Binding StockTexto}" Width="11*" MinWidth="84" />
              <controls:ColumnaNumero Header="Mínimo" Width="8*" MinWidth="70"
                                      Binding="{Binding StockMinimo, StringFormat={}{0:N2}}" />
              <controls:ColumnaNumero Header="Valor (USD)" Width="12*" MinWidth="84"
                                      Binding="{Binding ValorTotal, StringFormat={}{0:N2}}" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipStockStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Repuestos}"
                               Titulo="No hay artículos en el catálogo"
                               Detalle="Da de alta un repuesto o consumible para controlar su existencia."
                               Visibility="{Binding HasItems, ElementName=Tabla1, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Salidas de almacén: el documento que descuenta la existencia -->
    <Grid Grid.Row="2" Margin="0,16,0,0"
          Visibility="{Binding MostrarSalidas, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroSalidaCommand}">
              <ComboBoxItem Content="Todas" />
              <ComboBoxItem Content="Borrador" />
              <ComboBoxItem Content="Confirmada" />
              <ComboBoxItem Content="Anulada" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Nueva salida" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RegistrarSalidaCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarSalidaCommand}" />
            <Button Content="Confirmar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ConfirmarSalidaCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularSalidaCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarSalidaCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla2" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding SalidasView}"
                    SelectedItem="{Binding SalidaSeleccionada}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
              <controls:ColumnaTexto Header="Fecha" Width="10*" MinWidth="82"
                                     Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" />
              <controls:ColumnaTexto Header="Artículo" Binding="{Binding ArticuloNombre}" Width="22*" MinWidth="130" />
              <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="11*" MinWidth="84" />
              <controls:ColumnaTexto Header="Destino" Binding="{Binding DestinoTexto}" Width="18*" MinWidth="110" />
              <controls:ColumnaTexto Header="Mant." Binding="{Binding MantenimientoTexto}" Width="7*" MinWidth="64" />
              <controls:ColumnaNumero Header="Costo (USD)" Binding="{Binding CostoTotalTexto}" Width="9*" MinWidth="74" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoSalidaStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Inventario}"
                               Titulo="No hay salidas de almacén"
                               Detalle="Las salidas descuentan existencia y cargan el costo al activo."
                               Visibility="{Binding HasItems, ElementName=Tabla2, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
