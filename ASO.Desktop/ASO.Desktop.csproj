<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Software ASO</ApplicationTitle>
    <Product>Software ASO</Product>
    <Company>ASO</Company>
    <Description>Sistema de gestión de centros de procesamiento de caña de azúcar</Description>
    <ApplicationIcon>Assets\Logo\aso.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- Main propio (Program.cs) en vez del que genera App.xaml: Velopack tiene que correr antes
         que nada de WPF, porque al instalar, actualizar y desinstalar lanza el .exe con
         argumentos suyos y espera que salga sin abrir ventanas. -->
    <StartupObject>ASO.Desktop.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.28" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.28">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- La fuente de iconos viaja con el proyecto. Antes se usaba Segoe MDL2 Assets, que solo
       existe en Windows 10/11 y no se puede fijar a una version. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Phosphor.ttf" />
  </ItemGroup>

  <!-- Tipografia de la aplicacion (Satoshi, empotrada igual que Phosphor): asi no depende de que
       este instalada en la maquina. Los tres cortes comparten nombre de familia, asi que WPF
       elige el que toca por FontWeight y AppFont sigue siendo una sola clave. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Satoshi-Regular.ttf" />
    <Resource Include="Assets\Fonts\Satoshi-Medium.ttf" />
    <Resource Include="Assets\Fonts\Satoshi-Bold.ttf" />
  </ItemGroup>

  <!-- El mismo .ico que ApplicationIcon empotra en el .exe (para el Explorador), embebido ademas
       como Resource para que Window.Icon lo tome por pack URI: son dos mecanismos distintos, y
       ApplicationIcon solo cubre el primero. Sin esto, la barra de titulo y la barra de tareas
       de cada ventana se quedarian con el icono generico de WPF pese a que el .exe ya tiene el
       correcto. -->
  <ItemGroup>
    <Resource Include="Assets\Logo\aso.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Se copia para dotnet run / F5, pero NUNCA al publicar: el instalador acaba en GitHub
         Releases de un repo publico y este archivo lleva la cadena de conexion de la maquina.
         Instalada, la app lo busca en %LocalAppData%\ASO (ver AppConfig). -->
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
