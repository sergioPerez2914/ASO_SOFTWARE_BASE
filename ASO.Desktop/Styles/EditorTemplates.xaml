<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ASO.Desktop.ViewModels"
                    xmlns:views="clr-namespace:ASO.Desktop.Views">

  <!-- Cada editor CRUD aporta un UserControl de formulario; CrudEditorWindow los aloja
       a través de DataTemplate implícitos declarados aquí, sin conocer la entidad concreta.
       Se irán registrando a medida que cada submódulo tenga su editor. -->

  <DataTemplate DataType="{x:Type vm:RemesaEditorViewModel}">
    <views:RemesaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RecepcionRemesaEditorViewModel}">
    <views:RecepcionRemesaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AnularRemesaEditorViewModel}">
    <views:AnularRemesaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:NotaEditorViewModel}">
    <views:NotaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ActivoEditorViewModel}">
    <views:ActivoEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:MantenimientoEditorViewModel}">
    <views:MantenimientoEditorView />
  </DataTemplate>

</ResourceDictionary>
