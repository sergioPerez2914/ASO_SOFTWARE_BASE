        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoVale.Confirmado}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessTextBrush}" />
