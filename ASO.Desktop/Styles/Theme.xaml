        <Setter Property="BorderBrush" Value="{DynamicResource NeutralTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding EstaVencida}" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Chip de estado de una factura de proveedor. El disparador de vencida va al final:
       gana sobre el de Pendiente cuando ya pasó el plazo. -->
