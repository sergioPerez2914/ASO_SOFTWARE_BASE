      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Chip de estado de una factura al ingenio. El disparador de vencida va al final:
       gana sobre el de Emitida cuando ya pasó el plazo. -->
  <Style x:Key="ChipEstadoFacturaClienteStyle" TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoFacturaCliente.Borrador}">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoFacturaCliente.Emitida}">
        <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoFacturaCliente.Cobrada}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessTextBrush}" />
