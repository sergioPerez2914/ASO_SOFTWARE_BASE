  <!-- Chip de estado de un activo de flota -->
  <Style x:Key="ChipEstadoActivoStyle" TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoActivo.Operativo}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoActivo.EnTaller}">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoActivo.FueraDeServicio}">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Chip de urgencia de una recomendación de revisión -->
  <Style x:Key="ChipRecomendacionStyle" TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoRecomendacion.Vencido}">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoRecomendacion.Proximo}">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoRecomendacion.AlDia}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Nombre anterior de SectionCardStyle. Sigue vivo porque lo citan 64 sitios, para cuatro
       cosas distintas; las vistas lo van cambiando por el nombre que corresponda conforme se
       rehacen, y entonces desaparece. -->
  <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}" />

  <!-- Título de sección en tarjeta -->
  <Style x:Key="CardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Formularios: etiqueta + controles de captura. Solo setters, sin ControlTemplate,
       para heredar el comportamiento nativo de cada control. -->
  <Style x:Key="FormLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>

  <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Igual que el TextBox de formulario. Existe porque el PasswordBox sin estilo se pinta
       con los colores del sistema: sobre el tema oscuro saldria una caja blanca. -->
  <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="FormComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="FormDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Valor calculado de solo lectura dentro de un formulario (p. ej. el peso neto). -->
  <Style x:Key="FormValorCalculadoStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Icono de la navegación lateral (glifo MDL2).
       FontWeight fijo en Normal: la fuente no tiene cara bold y WPF la sintetiza,
       ensuciando el glifo justo en el estado seleccionado. -->
  <Style x:Key="NavIconStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Chevron de plegar/desplegar un módulo. Va anidado dentro del botón de módulo:
       WPF marca el clic como manejado, así que pliega sin disparar la navegación. -->
  <Style x:Key="NavChevronStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavPressedBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ítem de navegación lateral: módulo (primer nivel).
       El orden de la plantilla importa: la barra se dibuja DESPUÉS del fondo,
       si no el hover la tapa. -->
  <Style x:Key="NavItemStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="20,11,16,11" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Root" Background="{TemplateBinding Background}" />
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource NavIndicatorBrush}"
                    BorderThickness="0" SnapsToDevicePixels="True" />
            <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="0,6" CornerRadius="0,2,2,0" SnapsToDevicePixels="True"
                    Background="{DynamicResource NavIndicatorBrush}" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavPressedBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="BorderThickness" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
              <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Módulo abierto pero mostrando un submódulo: sólo color, sin fondo ni barra,
           para que nunca haya dos ítems marcados con barra a la vez. -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding EstaActivo}" Value="True" />
          <Condition Binding="{Binding EstaSeleccionado}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Ítem de navegación lateral: submódulo (segundo nivel).
       Misma plantilla que el módulo; sólo cambian tamaño, color base y sangría. -->
  <Style x:Key="NavSubItemStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource NavTextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="44,8,16,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Root" Background="{TemplateBinding Background}" />
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource NavIndicatorBrush}"
                    BorderThickness="0" SnapsToDevicePixels="True" />
            <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="0,5" CornerRadius="0,2,2,0" SnapsToDevicePixels="True"
                    Background="{DynamicResource NavIndicatorBrush}" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavPressedBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="BorderThickness" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
              <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tarjeta pulsable (módulo en Inicio, submódulo en el dashboard) -->
  <Style x:Key="CardButtonStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle de rango temporal -->
  <!-- ================= Pestanas y filtros: dos cosas, no una =================

       RangeToggleStyle se usaba 85 veces para dos trabajos que no se parecen: filtrar un listado
       (Pendientes / Resueltas / Todas) y hacer de pestana de seccion en Configuracion,
       Administracion y Peticiones. Como pastilla azul rellena, una pestana pesa lo mismo que el
       boton primario de la pantalla y compite con el.

       Se parten. La pestana se marca con una linea inferior, que es como se marca una pestana; el
       filtro se queda con la pastilla, que es como se marca un filtro. -->

  <!-- Pestana de seccion. Sin relleno: la subraya. -->
  <Style x:Key="SegmentedTabStyle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="{StaticResource FsSubtitle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2,6" />
    <Setter Property="Margin" Value="0,0,20,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentPresenter Grid.Row="0" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="Subrayado" Grid.Row="1" Height="2"
                    Background="Transparent" CornerRadius="{StaticResource RadPill}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Subrayado" Property="Background" Value="{DynamicResource NavIndicatorBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Subrayado" Property="Background" Value="{DynamicResource FocusRingBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filtro de listado. Pastilla tenida, no rellena de azul: en una barra con cinco filtros y un
       boton primario, cinco pastillas azules dejan de senalar nada. -->
  <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BdFino}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadPill}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InfoSoftBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InfoTextBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
              <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToggleHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Interruptor de un ajuste. Una casilla de verificacion dice "esto forma parte de lo que voy a
       guardar"; un interruptor dice "esto ya esta puesto". En Configuracion los ajustes se aplican
       al instante, asi que es lo segundo. -->
  <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Riel" Width="34" Height="18" VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadPill}"
                    BorderThickness="{StaticResource BdFino}"
                    Background="{DynamicResource NeutralSoftBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">
              <Border x:Name="Perilla" Width="12" Height="12" Margin="2,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      CornerRadius="{StaticResource RadPill}"
                      Background="{DynamicResource TextMutedBrush}" />
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Riel" Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
              <Setter TargetName="Riel" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}" />
              <Setter TargetName="Perilla" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Perilla" Property="Margin" Value="0,0,2,0" />
              <Setter TargetName="Perilla" Property="Background" Value="White" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Riel" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
              <Setter TargetName="Riel" Property="BorderThickness" Value="{StaticResource BdFoco}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RangeToggleStyle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="White" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToggleHoverBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Alerta de proceso -->
  <Style x:Key="AlertBoxStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- DataGrid -->
  <Style x:Key="DataGridStyle" TargetType="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource FilaAlternaBrush}" />
  </Style>

</ResourceDictionary>
