<Window x:Class="ASO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ASO.Desktop.Controls"
        xmlns:views="clr-namespace:ASO.Desktop.Views"
        mc:Ignorable="d"
        Title="Software ASO — Gestión de Zafra"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

  <!-- La escala de la interfaz es un LayoutTransform sobre la raiz, no un FontSize global:
       los estilos traen tamanos propios y subir solo la fuente descuadraria iconos, chips y
       columnas. Escalando el arbol entero todo crece a la vez. -->
  <Grid>
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="EscalaInterfaz" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Barra superior.

         Antes la ocupaba un Menu con cuatro entradas (_Archivo, _Ver, _Herramientas, A_yuda)
         sin hijos, sin Click y sin Command: decoracion inerte en el sitio mas visible de la
         ventana. Ese espacio es ahora la ruta de la seccion abierta, que es lo unico que hacia
         falta y no estaba: donde estoy y como vuelvo. -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="20,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:Breadcrumb x:Name="Ruta" Grid.Column="0" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Saber sobre que nucleo se esta escribiendo importa antes de guardar nada. -->
          <Border x:Name="NucleoChip" VerticalAlignment="Center" Margin="0,0,12,0"
                  CornerRadius="{StaticResource RadPill}" Padding="{StaticResource TkChip}"
                  Visibility="Collapsed"
                  BorderThickness="{StaticResource BdFino}"
                  Background="{DynamicResource InfoSoftBrush}"
                  BorderBrush="{DynamicResource InfoTextBrush}">
            <TextBlock x:Name="NucleoActualLabel"
                       FontSize="{StaticResource FsMicro}"
                       FontWeight="{StaticResource FwMedium}"
                       Foreground="{DynamicResource InfoTextBrush}" />
          </Border>

          <TextBlock x:Name="UsuarioActualLabel" VerticalAlignment="Center"
                     FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />

          <Button Content="Cerrar sesión" Style="{StaticResource SecondaryButtonStyle}"
                  ToolTip="Salir de la sesión y volver al inicio de sesión"
                  Click="OnCerrarSesion" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar -->
    <controls:Sidebar x:Name="MainSidebar" Grid.Row="1" Grid.Column="0"
                      BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0" />

    <!-- Contenido principal (cambia según la sección seleccionada).

         El ScrollViewer es del shell y no de cada pantalla: 36 de las 56 vistas no traen uno, y
         sin el, a escala 125 % con la ventana en su minimo (1024x640) el contenido se recortaba
         sin barra de desplazamiento y no habia forma de llegar a lo de abajo. Ponerlo aqui lo
         resuelve para todas a la vez. -->
    <ScrollViewer Grid.Row="1" Grid.Column="1"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                  Padding="20">
      <ContentControl x:Name="ContentArea" />
    </ScrollViewer>

  </Grid>
</Window>
